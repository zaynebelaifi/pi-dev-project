{% extends 'backend.html.twig' %}

{% block title %}Reservation Manager · BIG4 Admin{% endblock %}
{% block topbar_title %}Reservations{% endblock %}
{% block topbar_breadcrumb %}Admin / Reservations{% endblock %}

{% block body %}
    {% for msg in app.flashes('success') %}
        <div style="background:#dcfce7;border:1px solid #86efac;padding:10px;border-radius:8px;margin-bottom:10px;">{{ msg }}</div>
    {% endfor %}

    <div id="reservationResults">
        {% include 'Reservation/_results.html.twig' with {
            reservations: reservations,
            search: search,
            sort: sort,
            direction: direction
        } %}
    </div>
{% endblock %}
