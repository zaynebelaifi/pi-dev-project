{% extends 'backend.html.twig' %}

{% block title %}Ingredients · BIG 4 Admin{% endblock %}
{% block topbar_title %}Ingredient Stock{% endblock %}

{% block body %}
  <div class="sec-head">
    <div>
      <h2>Ingredient Inventory</h2>
      <p class="sec-sub">Manage stock, costs, expiry and low-stock risks.</p>
    </div>
    <div style="display:flex; gap:.7rem;">
      <a href="{{ path('admin_waste_index') }}" class="t-btn">Waste Logs</a>
      <form method="post" action="{{ path('admin_ingredient_import_csv') }}" enctype="multipart/form-data" style="display:flex; gap:.45rem; align-items:center;">
        <input type="hidden" name="_token" value="{{ csrf_token('import_ingredients_csv') }}">
        <input type="file" name="csv_file" accept=".csv,text/csv" required style="max-width:220px; font-size:.72rem;">
        <button type="submit" class="t-btn">Import CSV</button>
      </form>
      <form method="post" action="{{ path('admin_ingredient_sync_all') }}" style="display:inline-block;">
        <input type="hidden" name="_token" value="{{ csrf_token('sync_ingredients') }}">
        <button type="submit" class="t-btn" onclick="return confirm('Run full inventory sync? This will move expired stock to waste and merge duplicate ingredients.');">Fix Inventory</button>
      </form>
      <a href="{{ path('admin_ingredient_new') }}" class="t-btn primary">+ New Ingredient</a>
    </div>
  </div>

  <div class="kpi-row" style="margin-bottom:1.2rem;">
    <div class="kpi"><div class="kpi-lbl">Total Ingredients</div><div class="kpi-val">{{ stats.total }}</div></div>
    <div class="kpi"><div class="kpi-lbl">Low Stock</div><div class="kpi-val">{{ stats.lowStock }}</div></div>
    <div class="kpi"><div class="kpi-lbl">Expired</div><div class="kpi-val">{{ stats.expired }}</div></div>
    <div class="kpi"><div class="kpi-lbl">Inventory Value</div><div class="kpi-val">{{ stats.inventoryValue|number_format(2, '.', ' ') }} <span style="font-size:1rem; color:var(--text-3)">TND</span></div></div>
  </div>

  {% set hasFilters = search or status or unit or sort != 'name' or dir != 'ASC' %}
  <form method="get" class="list-filters" data-live-search="true" style="margin-bottom:1rem; display:flex; gap:.5rem; flex-wrap:wrap; align-items:center;">
    <input type="text" name="q" value="{{ search }}" placeholder="Search ingredient or unit" style="min-width:240px; padding:.65rem .8rem; border:1px solid var(--border-2); border-radius:8px;">

    <select name="status" style="padding:.6rem .75rem; border:1px solid var(--border-2); border-radius:8px; background:#fff;">
      <option value="" {{ status == '' ? 'selected' : '' }}>All Status</option>
      <option value="healthy" {{ status == 'healthy' ? 'selected' : '' }}>Healthy</option>
      <option value="low" {{ status == 'low' ? 'selected' : '' }}>Low Stock</option>
      <option value="expired" {{ status == 'expired' ? 'selected' : '' }}>Expired</option>
    </select>

    <select name="unit" style="padding:.6rem .75rem; border:1px solid var(--border-2); border-radius:8px; background:#fff;">
      <option value="" {{ unit == '' ? 'selected' : '' }}>All Units</option>
      {% for unitOption in units %}
        <option value="{{ unitOption }}" {{ unitOption == unit ? 'selected' : '' }}>{{ unitOption }}</option>
      {% endfor %}
    </select>

    <select name="sort" style="padding:.6rem .75rem; border:1px solid var(--border-2); border-radius:8px; background:#fff;">
      <option value="name" {{ sort == 'name' ? 'selected' : '' }}>Sort: Name</option>
      <option value="quantityInStock" {{ sort == 'quantityInStock' ? 'selected' : '' }}>Sort: Stock</option>
      <option value="minStockLevel" {{ sort == 'minStockLevel' ? 'selected' : '' }}>Sort: Min Level</option>
      <option value="unit" {{ sort == 'unit' ? 'selected' : '' }}>Sort: Unit</option>
      <option value="unitCost" {{ sort == 'unitCost' ? 'selected' : '' }}>Sort: Unit Cost</option>
      <option value="expiryDate" {{ sort == 'expiryDate' ? 'selected' : '' }}>Sort: Expiry</option>
      <option value="createdAt" {{ sort == 'createdAt' ? 'selected' : '' }}>Sort: Created</option>
    </select>

    <select name="dir" style="padding:.6rem .75rem; border:1px solid var(--border-2); border-radius:8px; background:#fff;">
      <option value="ASC" {{ dir == 'ASC' ? 'selected' : '' }}>Asc</option>
      <option value="DESC" {{ dir == 'DESC' ? 'selected' : '' }}>Desc</option>
    </select>

    {% if hasFilters %}<a href="{{ path('admin_ingredient_index') }}" class="t-btn">Reset</a>{% endif %}
  </form>

  <div class="delivery-table-card">
    <div class="table-header">
      <div class="table-title">Stock List</div>
      <div class="table-count">{{ ingredients|length }} rows</div>
    </div>

    {% if ingredients is empty %}
      <div class="no-results">No ingredients found.</div>
    {% else %}
      <table class="delivery-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Stock</th>
            <th>Min</th>
            <th>Unit</th>
            <th>Unit Cost</th>
            <th>Expiry</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for ingredient in ingredients %}
            {% set lowStock = ingredient.quantityInStock <= ingredient.minStockLevel %}
            {% set expired = ingredient.expiryDate and ingredient.expiryDate|date('Y-m-d') < today|date('Y-m-d') %}
            <tr class="{{ lowStock or expired ? 'warn-row' : '' }}">
              <td>{{ ingredient.name }}</td>
              <td>{{ ingredient.quantityInStock|number_format(2, '.', ' ') }}</td>
              <td>{{ ingredient.minStockLevel|number_format(2, '.', ' ') }}</td>
              <td>{{ ingredient.unit }}</td>
              <td>{{ ingredient.unitCost|number_format(2, '.', ' ') }} TND</td>
              <td>{{ ingredient.expiryDate ? ingredient.expiryDate|date('Y-m-d') : '—' }}</td>
              <td>
                {% if expired %}
                  <span class="status-badge status-cancelled">Expired</span>
                {% elseif lowStock %}
                  <span class="status-badge status-pending">Low Stock</span>
                {% else %}
                  <span class="status-badge status-completed">Healthy</span>
                {% endif %}
              </td>
              <td class="action-cell">
                <a href="{{ path('admin_ingredient_edit', {id: ingredient.id}) }}" class="mini-action">Edit</a>
                <form method="post" action="{{ path('admin_ingredient_delete', {id: ingredient.id}) }}" onsubmit="return confirm('Delete this ingredient?');" style="display:inline-block;">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_ingredient' ~ ingredient.id) }}">
                  <button class="mini-action mini-action-danger">Delete</button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </div>

  <style>
    /* KPI ENHANCEMENTS */
    .kpi {
      background: linear-gradient(135deg, var(--ivory) 0%, #fefcf7 100%);
      transition: all 0.3s ease;
      box-shadow: 0 2px 8px rgba(184,135,42,0.08);
    }
    .kpi:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(184,135,42,0.15);
      border-color: var(--gold);
    }
    .kpi-lbl {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.62rem;
      letter-spacing: 0.18em;
    }
    .kpi-val {
      font-size: 1.95rem;
      font-weight: 700;
      color: var(--espresso);
    }

    /* FILTER SECTION */
    .list-filters {
      background: var(--ivory);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.2rem;
      box-shadow: 0 2px 12px rgba(184,135,42,0.06);
    }
    .list-filters input,
    .list-filters select {
      font-family: 'Jost', sans-serif;
      font-size: 0.75rem;
      transition: all 0.25s;
    }
    .list-filters input:focus,
    .list-filters select:focus {
      border-color: var(--gold) !important;
      background-color: #fefef8;
      box-shadow: 0 0 0 3px rgba(184,135,42,0.08);
    }

    /* TABLE CARD */
    .delivery-table-card {
      background: var(--ivory);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 16px rgba(184,135,42,0.08);
    }
    .table-header {
      padding: 1.4rem 1.6rem;
      background: linear-gradient(90deg, rgba(184,135,42,0.04) 0%, rgba(184,135,42,0.02) 100%);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .table-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--espresso);
    }
    .table-count {
      font-size: 0.72rem;
      color: var(--text-3);
      letter-spacing: 0.08em;
      background: rgba(184,135,42,0.08);
      padding: 0.35rem 0.8rem;
      border-radius: 20px;
    }

    /* TABLE STYLING */
    .delivery-table {
      width: 100%;
      border-collapse: collapse;
    }
    .delivery-table thead {
      background: var(--ivory-2);
    }
    .delivery-table th {
      padding: 0.85rem 1.4rem;
      font-size: 0.64rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text-3);
      font-weight: 600;
      border-bottom: 2px solid var(--border-2);
      text-align: left;
    }
    .delivery-table tbody tr {
      border-bottom: 1px solid rgba(184,135,42,0.08);
      transition: all 0.2s ease;
    }
    .delivery-table tbody tr:hover {
      background: var(--gold-wash);
      box-shadow: inset 3px 0 0 var(--gold);
    }
    .delivery-table tbody tr:last-child {
      border-bottom: none;
    }
    .delivery-table td {
      padding: 1rem 1.4rem;
      font-size: 0.77rem;
      color: var(--text);
    }

    /* WARNING ROW */
    .warn-row {
      background: #fff5f0;
    }
    .warn-row:hover {
      background: #ffead6;
      box-shadow: inset 3px 0 0 var(--amber);
    }

    /* STATUS BADGES */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.4rem 0.85rem;
      border-radius: 20px;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.05em;
    }
    .status-completed {
      background: rgba(46,158,106,0.12);
      color: var(--green);
      border: 1px solid rgba(46,158,106,0.25);
    }
    .status-pending {
      background: rgba(200,125,32,0.12);
      color: var(--amber);
      border: 1px solid rgba(200,125,32,0.25);
    }
    .status-cancelled {
      background: rgba(217,64,64,0.12);
      color: var(--red);
      border: 1px solid rgba(217,64,64,0.25);
    }

    /* ACTION CELL */
    .action-cell {
      display: flex;
      gap: 0.55rem;
      flex-wrap: wrap;
      align-items: center;
    }

    /* ACTION BUTTONS */
    .mini-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.42rem 0.85rem;
      border-radius: 6px;
      border: 1px solid var(--border-2);
      background: #fff;
      color: var(--text-2);
      text-decoration: none;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: 'Jost', sans-serif;
    }
    .mini-action:hover {
      border-color: var(--gold);
      color: var(--gold);
      background: var(--gold-wash);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(184,135,42,0.12);
    }
    .mini-action-danger {
      border-color: rgba(217,64,64,0.3);
      color: var(--red);
      background: rgba(217,64,64,0.06);
    }
    .mini-action-danger:hover {
      border-color: var(--red);
      background: rgba(217,64,64,0.12);
      color: var(--red);
      box-shadow: 0 4px 12px rgba(217,64,64,0.15);
    }

    /* EMPTY STATE */
    .no-results {
      padding: 3rem 1.5rem;
      text-align: center;
      color: var(--text-3);
      font-size: 0.9rem;
      background: var(--ivory-2);
    }

    /* RESPONSIVE */
    @media (max-width: 1024px) {
      .list-filters {
        flex-wrap: wrap;
      }
      .table-header {
        flex-direction: column;
        gap: 0.8rem;
        align-items: flex-start;
      }
    }
  </style>
{% endblock %}
