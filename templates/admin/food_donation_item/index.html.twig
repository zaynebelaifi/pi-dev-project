{% extends 'backend.html.twig' %}

{% block title %}Donation Items · BIG4 Admin{% endblock %}
{% block topbar_title %}Donation Items{% endblock %}
{% block topbar_breadcrumb %}Admin / Donations / Items{% endblock %}

{% block body %}
    {% for msg in app.flashes('success') %}
        <div style="background:#dcfce7;border:1px solid #86efac;padding:10px;border-radius:8px;margin-bottom:10px;">{{ msg }}</div>
    {% endfor %}

    <p style="margin:0 0 12px; color:#4b5563;">Donation items page was stabilized after merge conflicts.</p>

    {% if groupedItems is defined and groupedItems is not empty %}
        <table style="width:100%;border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;">Event</th>
                    <th style="text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;">Items</th>
                </tr>
            </thead>
            <tbody>
                {% for group in groupedItems %}
                    <tr>
                        <td style="padding:8px;border-bottom:1px solid #f3f4f6;">{{ group.eventTitle|default('Event') }}</td>
                        <td style="padding:8px;border-bottom:1px solid #f3f4f6;">{{ group.items|length }} item(s)</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p style="color:#6b7280;">No donation items found.</p>
    {% endif %}
{% endblock %}
