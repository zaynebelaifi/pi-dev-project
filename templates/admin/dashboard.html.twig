{% extends 'backend.html.twig' %}

{% block title %}Admin Dashboard - BIG 4{% endblock %}

{% block topbar_title %}Dashboard{% endblock %}

{% block body %}
    <div class="sec-head">
      <div>
        <h2>Admin Dashboard</h2>
        <p class="sec-sub">Overview of delivery operations, assigned drivers, and active orders.</p>
      </div>
      <a href="{{ path('app_admin_support_queue') }}" class="t-btn primary">Support Queue</a>
    </div>

    <div class="kpi-row">
      <div class="kpi">
        <div class="kpi-lbl">Total Deliveries</div>
        <div class="kpi-val">{{ deliveryCount }}</div>
        <div class="kpi-chg up">Active monitoring</div>
      </div>
      <div class="kpi">
        <div class="kpi-lbl">Pending Orders</div>
        <div class="kpi-val">{{ pendingCount }}</div>
        <div class="kpi-chg down">Needs attention</div>
      </div>
      <div class="kpi">
        <div class="kpi-lbl">Assigned Deliveries</div>
        <div class="kpi-val">{{ assignedCount }}</div>
        <div class="kpi-chg up">In progress</div>
      </div>
      <div class="kpi">
        <div class="kpi-lbl">Ingredients</div>
        <div class="kpi-val">{{ ingredientCount }}</div>
        <div class="kpi-chg {{ lowStockCount > 0 ? 'down' : 'up' }}">{{ lowStockCount }} low-stock items</div>
      </div>
    </div>

    {% if autoWasteMoved > 0 %}
      <div style="margin-bottom:1rem; padding:.75rem 1rem; border:1px solid rgba(184,135,42,.25); border-radius:8px; background:#fff8eb; color:var(--brown);">
        Automation moved {{ autoWasteMoved }} expired ingredient stocks to waste records.
      </div>
    {% endif %}

    <div class="mod-grid">
      <div class="mod-card" onclick="location.href='{{ path('app_delivery_index') }}'">
        <div class="card-top">
          <div>
            <p class="c-title">Deliveries</p>
            <p class="c-desc">View and manage all current and pending delivery orders.</p>
          </div>
          <div class="c-icon gold">🚚</div>
        </div>
        <div class="c-stats">
          <div class="cs-item">
            <div class="cs-num">{{ deliveryCount }}</div>
            <div class="cs-lbl">Total orders</div>
          </div>
          <div class="cs-item">
            <div class="cs-num">{{ pendingCount }}</div>
            <div class="cs-lbl">Pending</div>
          </div>
        </div>
      </div>

      <div class="mod-card" onclick="location.href='{{ path('app_delivery_man_index') }}'">
        <div class="card-top">
          <div>
            <p class="c-title">Delivery Team</p>
            <p class="c-desc">Manage drivers and review assignments across the fleet.</p>
          </div>
          <div class="c-icon green">👥</div>
        </div>
        <div class="c-stats">
          <div class="cs-item">
            <div class="cs-num">{{ deliveryManCount }}</div>
            <div class="cs-lbl">Drivers</div>
          </div>
          <div class="cs-item">
            <div class="cs-num">{{ assignedCount }}</div>
            <div class="cs-lbl">Assigned</div>
          </div>
        </div>
      </div>

      <div class="mod-card" onclick="location.href='{{ path('admin_ingredient_index') }}'">
        <div class="card-top">
          <div>
            <p class="c-title">Ingredient Stock</p>
            <p class="c-desc">Track stock levels, low-stock alerts and expiry-driven waste reduction.</p>
          </div>
          <div class="c-icon amber">🥬</div>
        </div>
        <div class="c-stats">
          <div class="cs-item">
            <div class="cs-num">{{ lowStockCount }}</div>
            <div class="cs-lbl">Low Stock</div>
          </div>
          <div class="cs-item">
            <div class="cs-num">{{ expiredCount }}</div>
            <div class="cs-lbl">Expired</div>
          </div>
        </div>
      </div>

      <div class="mod-card" onclick="location.href='{{ path('app_admin_vehicles') }}'">
        <div class="card-top">
          <div>
            <p class="c-title">Fleet Vehicles</p>
            <p class="c-desc">Manage vehicles and assign drivers to the fleet.</p>
          </div>
          <div class="c-icon blue">🚙</div>
        </div>
        <div class="c-stats">
          <div class="cs-item">
            <div class="cs-num">{{ vehicleCount }}</div>
            <div class="cs-lbl">Vehicles</div>
          </div>
        </div>
      </div>

      <div class="mod-card" onclick="location.href='{{ path('admin_fleet_dashboard') }}'">
        <div class="card-top">
          <div>
            <p class="c-title">Fleet Management</p>
            <p class="c-desc">Monitor live driver tracking, smart assignment, and real-time delivery map.</p>
          </div>
          <div class="c-icon purple">🗺️</div>
        </div>
        <div class="c-stats">
          <div class="cs-item">
            <div class="cs-num">{{ deliveryManCount }}</div>
            <div class="cs-lbl">Drivers</div>
          </div>
          <div class="cs-item">
            <div class="cs-num" style="color:var(--green);font-size:.85rem">● Live</div>
            <div class="cs-lbl">Map Active</div>
          </div>
        </div>
      </div>

      <div class="mod-card" onclick="location.href='{{ path('app_admin_users') }}'">
        <div class="card-top">
          <div>
            <p class="c-title">Users Management</p>
            <p class="c-desc">Manage clients, delivery men, and admin accounts.</p>
          </div>
          <div class="c-icon red">👤</div>
        </div>
        <div class="q-grid mt-3">
          <button class="q-btn" onclick="fetchDashboardStats()">
            <span class="q-icon">📊</span>
            <span class="q-lbl">View Statistics</span>
            <span class="q-sub">Engagement metrics</span>
          </button>
          <button class="q-btn" onclick="fetchDashboardInactive()">
            <span class="q-icon">💤</span>
            <span class="q-lbl">Inactive Users</span>
            <span class="q-sub">Churn prevention</span>
          </button>
          <button class="q-btn" onclick="fetchDashboardLoyalty()">
            <span class="q-icon">⭐</span>
            <span class="q-lbl">Loyalty Score</span>
            <span class="q-sub">Top members list</span>
          </button>
          <button class="q-btn" onclick="fetchDashboardAI()">
            <span class="q-icon">🤖</span>
            <span class="q-lbl">AI Insight</span>
            <span class="q-sub">Smart segmentation</span>
          </button>
        </div>
      </div>

      <div class="mod-card">
        <div class="card-top">
          <div>
            <p class="c-title">Quick Actions</p>
            <p class="c-desc">Use quick links to access delivery creation and management controls.</p>
          </div>
          <div class="c-icon blue">⚡</div>
        </div>
        <div class="q-grid">
          <button class="q-btn" onclick="location.href='{{ path('app_delivery_new') }}'">
            <span class="q-icon">➕</span>
            <span class="q-lbl">New Delivery</span>
            <span class="q-sub">Create order manually</span>
          </button>
          <button class="q-btn" onclick="location.href='{{ path('app_delivery_index') }}'">
            <span class="q-icon">📋</span>
            <span class="q-lbl">All Deliveries</span>
            <span class="q-sub">Review status board</span>
          </button>
          <button class="q-btn" onclick="location.href='{{ path('admin_waste_new') }}'">
            <span class="q-icon">🗑️</span>
            <span class="q-lbl">Log Waste</span>
            <span class="q-sub">Adjust stock instantly</span>
          </button>
          <button class="q-btn" onclick="location.href='{{ path('admin_ingredient_new') }}'">
            <span class="q-icon">➕</span>
            <span class="q-lbl">New Ingredient</span>
            <span class="q-sub">Update recipe stock base</span>
          </button>
        </div>
      </div>
    </div>
  </div>

    <!-- Dashboard Result Modal -->
    <div id="dashResultModal" class="modal fade" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 20px; border: 1px solid var(--gold); background: var(--ivory);">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="dashResultTitle" style="font-family: 'Cormorant Garamond', serif; font-weight: 700; color: var(--gold); font-size: 1.5rem;">Insights</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="dashResultBody" style="font-size: 0.9rem; color: var(--text-2);">
                    <!-- Dynamic content here -->
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="t-btn primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const dashModalElement = document.getElementById('dashResultModal');
        const dashModal = dashModalElement ? new bootstrap.Modal(dashModalElement) : null;
        const dashTitle = document.getElementById('dashResultTitle');
        const dashBody = document.getElementById('dashResultBody');

        function showDashResult(title, html) {
            if (!dashModal) return;
            dashTitle.textContent = title;
            dashBody.innerHTML = html;
            dashModal.show();
        }

        async function fetchDashboardStats() {
            try {
                const res = await fetch('/api/users/1/stats');
                const data = await res.json();
                showDashResult('User Engagement Statistics', `
                    <div class="p-3 mb-2" style="background:var(--gold-wash); border-radius:12px;">
                        <p><strong>Representative Member:</strong> Admin Manager</p>
                        <p><strong>Total Orders:</strong> ${data.total_orders}</p>
                        <p><strong>Total Spending:</strong> ${data.total_spent} ${data.currency}</p>
                        <p><strong>Last Activity:</strong> ${data.last_order_date}</p>
                    </div>
                `);
            } catch(e) { console.error(e); }
        }

        async function fetchDashboardInactive() {
            try {
                const res = await fetch('/api/users/inactive');
                const data = await res.json();
                let html = data.length > 0 
                    ? data.map(u => `<div class="mb-2 p-2 border-bottom"><strong>${u.name}</strong><br><span class="small">Last order: ${u.last_order}</span></div>`).join('')
                    : '<p>All customers are currently active!</p>';
                showDashResult('Inactive Users (30d)', `<div style="max-height: 300px; overflow-y: auto;">${html}</div>`);
            } catch(e) { console.error(e); }
        }

        async function fetchDashboardLoyalty() {
            try {
                const res = await fetch('/api/users/1/loyalty-score');
                const data = await res.json();
                showDashResult('Loyalty Insights', `
                    <div class="text-center p-4" style="background:var(--gold-wash); border-radius:15px;">
                        <div style="font-size: 2.5rem; color: var(--gold); font-weight: 700;">${data.score}</div>
                        <div class="pill p-amber mt-2">${data.tier} MEMBER</div>
                        <div class="progress mt-4" style="height: 8px;">
                            <div class="progress-bar" style="width: ${data.next_tier_progress}%; background: var(--gold);"></div>
                        </div>
                    </div>
                `);
            } catch(e) { console.error(e); }
        }

        async function fetchDashboardAI() {
            try {
                const res = await fetch('/api/users/1/recommendation');
                const data = await res.json();
                showDashResult('AI Strategic Recommendation', `
                    <div class="p-3" style="border-left: 4px solid var(--gold); background: #fff8eb;">
                        <p class="font-italic" style="font-size: 1.1rem; color: var(--espresso);">"${data.recommendation}"</p>
                    </div>
                `);
            } catch(e) { console.error(e); }
        }
    </script>
{% endblock %}

