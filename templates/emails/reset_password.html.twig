<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset your BIG 4 password</title>
  <style>
    /* ── Reset & base ── */
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
    body {
      margin: 0; padding: 0;
      background-color: #f5f0e8;
      font-family: 'Segoe UI', Arial, sans-serif;
      color: #2c1a0e;
    }

    /* ── Wrapper ── */
    .wrapper {
      width: 100%; max-width: 600px;
      margin: 40px auto;
      background: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 40px rgba(141, 109, 57, 0.14);
      border: 1px solid rgba(209, 184, 120, 0.25);
    }

    /* ── Header ── */
    .header {
      background: linear-gradient(135deg, #1a0f00 0%, #2c1a0e 100%);
      padding: 36px 40px 28px;
      text-align: center;
    }
    .header-brand {
      font-size: 2rem;
      font-weight: 800;
      color: #d4a843;
      letter-spacing: 0.12em;
      margin: 0;
    }
    .header-sub {
      color: rgba(212, 168, 67, 0.65);
      font-size: 0.78rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      margin: 4px 0 0;
    }

    /* ── Gold bar ── */
    .gold-bar { height: 4px; background: linear-gradient(90deg, #c7972f, #e8c56a, #c7972f); }

    /* ── Body ── */
    .body { padding: 40px 40px 32px; }
    .greeting { font-size: 1.15rem; font-weight: 600; color: #2c1a0e; margin: 0 0 16px; }
    .body p { font-size: 0.97rem; line-height: 1.7; color: #4a3728; margin: 0 0 20px; }

    /* ── CTA button ── */
    .btn-wrap { text-align: center; margin: 32px 0; }
    .btn-reset {
      display: inline-block;
      padding: 16px 40px;
      background: linear-gradient(135deg, #c7972f 0%, #b27a1d 100%);
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 50px;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      box-shadow: 0 8px 24px rgba(178, 122, 29, 0.35);
    }

    /* ── Expiry notice ── */
    .expiry-box {
      background: #fff8ec;
      border: 1px solid rgba(209, 184, 120, 0.35);
      border-radius: 10px;
      padding: 14px 18px;
      font-size: 0.88rem;
      color: #7a5c2e;
      margin: 0 0 24px;
      text-align: center;
    }
    .expiry-box strong { color: #b27a1d; }

    /* ── Fallback URL ── */
    .fallback {
      font-size: 0.8rem;
      color: #9e8060;
      word-break: break-all;
      background: #faf7f2;
      border-radius: 8px;
      padding: 10px 14px;
      margin: 0 0 24px;
    }
    .fallback a { color: #b27a1d; }

    /* ── Security note ── */
    .security-note {
      font-size: 0.83rem;
      color: #9e8060;
      border-top: 1px solid rgba(209, 184, 120, 0.2);
      padding-top: 20px;
      margin-top: 8px;
    }

    /* ── Footer ── */
    .footer {
      background: #faf7f2;
      padding: 20px 40px;
      text-align: center;
      font-size: 0.8rem;
      color: #b09070;
      border-top: 1px solid rgba(209, 184, 120, 0.18);
    }
  </style>
</head>
<body>
  <div class="wrapper">

    <!-- Header -->
    <div class="header">
      <p class="header-brand">BIG 4</p>
      <p class="header-sub">Coffee Lounge</p>
    </div>
    <div class="gold-bar"></div>

    <!-- Body -->
    <div class="body">
      <p class="greeting">Hi {{ firstName }},</p>

      <p>
        We received a request to reset the password for your BIG 4 account.
        Click the button below to choose a new password.
      </p>

      <!-- CTA -->
      <div class="btn-wrap">
        <a href="{{ resetUrl }}" class="btn-reset">Reset my password</a>
      </div>

      <!-- Expiry notice -->
      <div class="expiry-box">
        ⏱ This link expires in <strong>{{ tokenTtlMin }} minutes</strong>
        (at {{ expiresAt|date('H:i') }} on {{ expiresAt|date('d/m/Y') }}).
      </div>

      <!-- Fallback plain URL -->
      <p>If the button above doesn't work, copy and paste this link into your browser:</p>
      <div class="fallback">
        <a href="{{ resetUrl }}">{{ resetUrl }}</a>
      </div>

      <!-- Security note -->
      <p class="security-note">
        If you did not request a password reset, you can safely ignore this email —
        your password will not be changed. For security, this link can only be used once.
      </p>
    </div>

    <!-- Footer -->
    <div class="footer">
      &copy; {{ "now"|date("Y") }} BIG 4 Coffee Lounge. All rights reserved.<br>
      This is an automated message — please do not reply.
    </div>

  </div>
</body>
</html>
