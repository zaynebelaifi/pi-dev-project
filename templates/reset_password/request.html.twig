{% extends 'base.html.twig' %}

{% block title %}Forgot Password — BIG 4{% endblock %}

{% block body %}
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-panel">

      {# ── Left intro panel ── #}
      <div class="auth-intro">
        <span class="auth-tag">BIG 4 Coffee Lounge</span>
        <h1>Forgot your password?</h1>
        <p>
          No worries — enter the email address linked to your account and
          we'll send you a secure reset link within seconds.
        </p>
      </div>

      {# ── Right form panel ── #}
      <div class="auth-side">

        {# Flash errors (e.g. redirected back from an expired token) #}
        {% for message in app.flashes('error') %}
          <div class="alert alert-error">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

          <div class="form-row">
            {{ form_label(form.email) }}
            {{ form_widget(form.email) }}
            {{ form_errors(form.email) }}
          </div>

          <button type="submit" class="btn btn-primary">
            Send reset link
          </button>

        {{ form_end(form) }}

        <p class="auth-footer">
          Remembered it?
          <a href="{{ path('app_login') }}">Back to Sign In</a>
        </p>

      </div>{# /auth-side #}
    </div>{# /auth-panel #}
  </div>{# /auth-card #}
</div>{# /auth-page #}

<style>
/* ── Shared auth layout (mirrors login/register) ── */
.auth-page {
  min-height: calc(100vh - 120px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
  background: radial-gradient(circle at top, rgba(255,244,214,.65), transparent 35%),
              linear-gradient(180deg, #f9f5ec 0%, #fffdf9 100%);
}
.auth-card {
  width: min(100%, 680px);
  background: rgba(255,255,255,.96);
  border-radius: 32px;
  border: 1px solid rgba(209,184,120,.18);
  box-shadow: 0 40px 120px rgba(141,109,57,.12);
  overflow: hidden;
}
.auth-panel { display: grid; grid-template-columns: 1fr; }
.auth-intro {
  padding: 2.5rem 2rem 1.75rem;
  background: linear-gradient(135deg, rgba(255,243,205,.95), rgba(255,244,222,.9));
  border-bottom: 1px solid rgba(209,184,120,.22);
}
.auth-tag {
  display: inline-block;
  margin-bottom: 1rem;
  padding: .45rem .9rem;
  border-radius: 999px;
  background: rgba(214,168,72,.14);
  color: var(--brown, #7a4f1e);
  font-size: .8rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}
.auth-intro h1 { margin: 0; font-size: clamp(1.8rem,3vw,2.2rem); color: var(--brown, #7a4f1e); }
.auth-intro p  { margin: 1rem 0 0; color: var(--text-2, #6b5744); line-height: 1.7; }
.auth-side { padding: 2rem; }
.form-row { margin-bottom: 1.2rem; }
.form-row label {
  display: block;
  margin-bottom: .45rem;
  color: var(--brown, #7a4f1e);
  font-weight: 700;
}
.form-row input,
.form-input {
  width: 100%;
  min-height: 48px;
  padding: .95rem 1rem;
  border-radius: 16px;
  border: 1px solid rgba(184,135,42,.22);
  background: #fff;
  color: var(--espresso, #2c1a0e);
  font-size: 1rem;
  box-sizing: border-box;
}
.form-row input:focus,
.form-input:focus {
  outline: none;
  border-color: var(--gold, #c7972f);
  box-shadow: 0 0 0 4px rgba(255,222,143,.22);
}
.btn {
  width: 100%;
  padding: 1rem 1.15rem;
  border-radius: 18px;
  border: none;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform .18s ease, background .18s ease;
}
.btn-primary {
  background: linear-gradient(135deg, #c7972f 0%, #b27a1d 100%);
  color: #fff;
  box-shadow: 0 12px 24px rgba(178,122,29,.28);
}
.btn-primary:hover {
  background: linear-gradient(135deg, #b27a1d 0%, #8a5b12 100%);
  transform: translateY(-1px);
}
.alert-error {
  background: #fff1f3;
  color: #842029;
  border: 1px solid #f5c2c7;
  padding: 1rem 1.1rem;
  border-radius: 16px;
  margin-bottom: 1.25rem;
  font-size: .95rem;
}
.auth-footer {
  margin-top: 1.4rem;
  text-align: center;
  color: var(--text-2, #6b5744);
  font-size: .97rem;
}
.auth-footer a { color: var(--gold, #c7972f); font-weight: 700; text-decoration: none; }
/* Symfony form error list */
.form-row ul { margin: .4rem 0 0; padding: 0 0 0 1.1rem; color: #842029; font-size: .88rem; }
@media (max-width: 680px) {
  .auth-card { border-radius: 26px; }
  .auth-intro { padding: 2rem 1.5rem 1.5rem; }
  .auth-side  { padding: 1.75rem 1.5rem; }
}
</style>
{% endblock %}
