{% extends 'base.html.twig' %}

{% block title %}Reset Password — BIG 4{% endblock %}

{% block body %}
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-panel">

      {# ── Left intro panel ── #}
      <div class="auth-intro">
        <span class="auth-tag">BIG 4 Coffee Lounge</span>
        <h1>Set a new password</h1>
        <p>
          Choose a strong password with at least 8 characters,
          one uppercase letter, and one number.
        </p>

        {# Token expiry countdown hint #}
        <div class="expiry-hint">
          ⏱ Link expires at
          <strong>{{ expiresAt|date('H:i') }}</strong>
          on {{ expiresAt|date('d/m/Y') }}
        </div>
      </div>

      {# ── Right form panel ── #}
      <div class="auth-side">

        {# Flash errors #}
        {% for message in app.flashes('error') %}
          <div class="alert alert-error">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {
          action: path('app_reset_password', { token: token }),
          attr: { novalidate: 'novalidate' }
        }) }}

          <div class="form-row">
            {{ form_label(form.plainPassword.first) }}
            {{ form_widget(form.plainPassword.first) }}
            {{ form_errors(form.plainPassword.first) }}
          </div>

          <div class="form-row">
            {{ form_label(form.plainPassword.second) }}
            {{ form_widget(form.plainPassword.second) }}
            {{ form_errors(form.plainPassword.second) }}
          </div>

          {# Password strength hints #}
          <ul class="pw-hints">
            <li id="hint-length">At least 8 characters</li>
            <li id="hint-upper">One uppercase letter (A–Z)</li>
            <li id="hint-number">One number (0–9)</li>
          </ul>

          <button type="submit" class="btn btn-primary">
            Save new password
          </button>

        {{ form_end(form) }}

        <p class="auth-footer">
          <a href="{{ path('app_forgot_password') }}">Request a new link</a>
        </p>

      </div>{# /auth-side #}
    </div>{# /auth-panel #}
  </div>{# /auth-card #}
</div>{# /auth-page #}

<style>
/* ── Shared auth layout ── */
.auth-page {
  min-height: calc(100vh - 120px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
  background: radial-gradient(circle at top, rgba(255,244,214,.65), transparent 35%),
              linear-gradient(180deg, #f9f5ec 0%, #fffdf9 100%);
}
.auth-card {
  width: min(100%, 680px);
  background: rgba(255,255,255,.96);
  border-radius: 32px;
  border: 1px solid rgba(209,184,120,.18);
  box-shadow: 0 40px 120px rgba(141,109,57,.12);
  overflow: hidden;
}
.auth-panel { display: grid; grid-template-columns: 1fr; }
.auth-intro {
  padding: 2.5rem 2rem 1.75rem;
  background: linear-gradient(135deg, rgba(255,243,205,.95), rgba(255,244,222,.9));
  border-bottom: 1px solid rgba(209,184,120,.22);
}
.auth-tag {
  display: inline-block;
  margin-bottom: 1rem;
  padding: .45rem .9rem;
  border-radius: 999px;
  background: rgba(214,168,72,.14);
  color: var(--brown, #7a4f1e);
  font-size: .8rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}
.auth-intro h1 { margin: 0; font-size: clamp(1.8rem,3vw,2.2rem); color: var(--brown, #7a4f1e); }
.auth-intro p  { margin: 1rem 0 .75rem; color: var(--text-2, #6b5744); line-height: 1.7; }
.expiry-hint {
  display: inline-block;
  background: rgba(199,151,47,.1);
  color: #7a5c2e;
  border-radius: 8px;
  padding: .4rem .8rem;
  font-size: .83rem;
}
.auth-side { padding: 2rem; }
.form-row { margin-bottom: 1.2rem; }
.form-row label {
  display: block;
  margin-bottom: .45rem;
  color: var(--brown, #7a4f1e);
  font-weight: 700;
}
.form-row input,
.form-input {
  width: 100%;
  min-height: 48px;
  padding: .95rem 1rem;
  border-radius: 16px;
  border: 1px solid rgba(184,135,42,.22);
  background: #fff;
  color: var(--espresso, #2c1a0e);
  font-size: 1rem;
  box-sizing: border-box;
}
.form-row input:focus,
.form-input:focus {
  outline: none;
  border-color: var(--gold, #c7972f);
  box-shadow: 0 0 0 4px rgba(255,222,143,.22);
}
/* Password strength hints */
.pw-hints {
  list-style: none;
  padding: 0;
  margin: -.4rem 0 1.4rem;
  display: flex;
  flex-wrap: wrap;
  gap: .4rem .8rem;
}
.pw-hints li {
  font-size: .8rem;
  color: #9e8060;
  padding: .25rem .6rem;
  border-radius: 6px;
  background: #faf7f2;
  border: 1px solid rgba(184,135,42,.15);
  transition: color .2s, background .2s, border-color .2s;
}
.pw-hints li.ok {
  color: #2d6a4f;
  background: #d8f3dc;
  border-color: #95d5b2;
}
.btn {
  width: 100%;
  padding: 1rem 1.15rem;
  border-radius: 18px;
  border: none;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform .18s ease, background .18s ease;
}
.btn-primary {
  background: linear-gradient(135deg, #c7972f 0%, #b27a1d 100%);
  color: #fff;
  box-shadow: 0 12px 24px rgba(178,122,29,.28);
}
.btn-primary:hover {
  background: linear-gradient(135deg, #b27a1d 0%, #8a5b12 100%);
  transform: translateY(-1px);
}
.alert-error {
  background: #fff1f3;
  color: #842029;
  border: 1px solid #f5c2c7;
  padding: 1rem 1.1rem;
  border-radius: 16px;
  margin-bottom: 1.25rem;
  font-size: .95rem;
}
.auth-footer {
  margin-top: 1.4rem;
  text-align: center;
  color: var(--text-2, #6b5744);
  font-size: .97rem;
}
.auth-footer a { color: var(--gold, #c7972f); font-weight: 700; text-decoration: none; }
/* Symfony form error list */
.form-row ul { margin: .4rem 0 0; padding: 0 0 0 1.1rem; color: #842029; font-size: .88rem; }
@media (max-width: 680px) {
  .auth-card { border-radius: 26px; }
  .auth-intro { padding: 2rem 1.5rem 1.5rem; }
  .auth-side  { padding: 1.75rem 1.5rem; }
}
</style>

{# ── Live password-strength hints ── #}
<script>
(function () {
  // Find the first password input inside the reset form
  const form = document.querySelector('form[action*="reset-password"]');
  if (!form) return;

  const pwInput = form.querySelector('input[type="password"]');
  if (!pwInput) return;

  const hintLength = document.getElementById('hint-length');
  const hintUpper  = document.getElementById('hint-upper');
  const hintNumber = document.getElementById('hint-number');

  pwInput.addEventListener('input', function () {
    const v = this.value;
    hintLength && hintLength.classList.toggle('ok', v.length >= 8);
    hintUpper  && hintUpper.classList.toggle('ok',  /[A-Z]/.test(v));
    hintNumber && hintNumber.classList.toggle('ok', /[0-9]/.test(v));
  });
})();
</script>
{% endblock %}
