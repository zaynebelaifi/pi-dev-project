  <script>
    (function () {
      const REGISTRATION_STATE_ENDPOINT = '{{ path('app_client_food_donation_registration_state') }}';
      const REGISTRATION_SYNC_MS = 15000;

      const showToast = (message, type = 'success') => {
        const toast = document.createElement('div');
        toast.className = `flash-message ${type === 'error' ? 'flash-error' : 'flash-success'}`;
        toast.textContent = String(message || 'Done.');
        document.body.prepend(toast);
        window.setTimeout(() => {
          toast.remove();
        }, 2600);
      };

      window.BIG4ShowToast = showToast;

      const escapeHtml = (value) => String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

      const setRegistrationCount = (eventId, count) => {
        document.querySelectorAll(`[data-registration-count-for="${eventId}"]`).forEach((node) => {
          node.textContent = String(Number(count || 0));
        });
      };

      const setButtonState = (button, action) => {
        const normalized = action === 'register' ? 'register' : 'unregister';
        button.dataset.action = normalized;
        button.textContent = normalized === 'register' ? 'Register' : 'Unregister';
        button.classList.toggle('btn-register', normalized === 'register');
        button.classList.toggle('btn-unregister', normalized === 'unregister');
        button.classList.toggle('btn-unregister-sm', normalized === 'unregister' && button.classList.contains('btn-unregister-sm'));
      };

      const replaceEventCardRegisterState = (eventId, isRegistered, registerToken) => {
        const wrapper = document.querySelector(`.event[data-event-id="${eventId}"] [data-register-wrapper]`);
        if (!wrapper) {
          return;
        }

        const currentToken = wrapper.querySelector('input[name="_token"]')?.value || '';
        const effectiveToken = String(registerToken || currentToken || '');
        const currentCount = Number(document.querySelector(`[data-registration-count-for="${eventId}"]`)?.textContent || 0);

        if (isRegistered) {
          wrapper.dataset.registered = '1';
          wrapper.innerHTML = `
            <div class="registered-badge">
              <span>Registered</span>
            </div>
          `;
          return;
        }

        wrapper.dataset.registered = '0';
        wrapper.innerHTML = `
          <div class="register-status">
            <span class="status-badge">SCHEDULED</span>
            <span class="registered-count">${currentCount} registered</span>
          </div>
          <form method="post" action="/client/food-donation/event/${eventId}/register" class="js-event-register-form" data-event-id="${eventId}">
            <input type="hidden" name="_token" value="${effectiveToken}">
            <button type="submit" class="event-register-btn-ui">Register</button>
          </form>
        `;
      };

      const renderMyRegisteredEvents = (events) => {
        const grid = document.querySelector('#myRegisteredEventsPopup .my-events-grid');
        if (!grid) {
          return;
        }

        if (!Array.isArray(events) || events.length === 0) {
          grid.innerHTML = '<p class="empty-copy js-no-events-msg">You have no registered events.</p>';
          return;
        }

        grid.innerHTML = events.map((event) => {
          const eventId = Number(event.id || 0);
          return `
            <article class="my-event-card">
              <span class="my-event-date">${escapeHtml(event.event_date || 'Date TBD')}</span>
              <h4 class="my-event-title">${escapeHtml(event.charity_name || ('Event #' + eventId))}</h4>
              <p class="my-event-summary">
                ${Number(event.total_quantity || 0)} items · ${escapeHtml(event.status || 'Scheduled')} ·
                <span data-registration-count-for="${eventId}">${Number(event.registration_count || 0)}</span> registered
              </p>
              <div class="event-inline-actions">
                <a class="event-register-btn-ui" href="${escapeHtml(event.view_url || '#')}">View Details</a>
                <button
                  type="button"
                  class="event-register-btn-ui js-unregister-btn"
                  data-event-id="${eventId}"
                  data-unregister-url="${escapeHtml(event.unregister_url || '')}"
                  data-csrf="${escapeHtml(event.unregister_token || '')}"
                >Unregister</button>
              </div>
            </article>
          `;
        }).join('');
      };

      const upsertMyRegisteredEventCard = (eventId, registrationCount = 0, eventData = null) => {
        const grid = document.querySelector('#myRegisteredEventsPopup .my-events-grid');
        if (!grid || !eventId) {
          return;
        }

        const existingCard = grid.querySelector(`.my-event-card [data-event-id="${eventId}"]`)?.closest('.my-event-card');
        if (existingCard) {
          const countNode = existingCard.querySelector(`[data-registration-count-for="${eventId}"]`);
          if (countNode) {
            countNode.textContent = String(Number(registrationCount || 0));
          }
          return;
        }

        const emptyMessage = grid.querySelector('.js-no-events-msg');
        if (emptyMessage) {
          emptyMessage.remove();
        }

        const eventRow = document.querySelector(`.event[data-event-id="${eventId}"]`);
        const title = String(eventData?.charity_name || eventRow?.querySelector('h5')?.textContent || `Event #${eventId}`).trim();
        const status = String(eventData?.status || eventRow?.querySelector('[data-event-status]')?.textContent || 'Scheduled').trim();

        const summaryText = (eventRow?.querySelector('p')?.textContent || 'Date TBD').replace(/\s+/g, ' ').trim();
        const summaryParts = summaryText.split('·').map((part) => part.trim()).filter(Boolean);
        const eventDate = String(eventData?.event_date || (summaryParts.length > 0 ? summaryParts[0] : 'Date TBD')).trim();

        let quantity = Number(eventData?.total_quantity || 0);
        const qtyMatch = summaryText.match(/(\d+)\s*items/i);
        if (quantity <= 0 && qtyMatch && qtyMatch[1]) {
          quantity = Number(qtyMatch[1]) || 0;
        }

        const registerWrapper = eventRow?.querySelector('[data-register-wrapper]');
        const unregisterToken = String(eventData?.unregister_token || registerWrapper?.dataset.unregisterToken || '');
        const viewUrl = String(eventData?.view_url || `/client/food-donation/event/${eventId}`);
        const unregisterUrl = String(eventData?.unregister_url || `/client/food-donation/event/${eventId}/unregister`);

        const card = document.createElement('article');
        card.className = 'my-event-card';
        card.innerHTML = `
          <span class="my-event-date">${escapeHtml(eventDate)}</span>
          <h4 class="my-event-title">${escapeHtml(title)}</h4>
          <p class="my-event-summary">
            ${Number(quantity)} items · ${escapeHtml(status)} ·
            <span data-registration-count-for="${eventId}">${Number(registrationCount || 0)}</span> registered
          </p>
          <div class="event-inline-actions">
            <a class="event-register-btn-ui" href="${escapeHtml(viewUrl)}">View Details</a>
            <button
              type="button"
              class="event-register-btn-ui js-unregister-btn"
              data-event-id="${eventId}"
              data-unregister-url="${escapeHtml(unregisterUrl)}"
              data-csrf="${escapeHtml(unregisterToken)}"
            >Unregister</button>
          </div>
        `;

        card.style.opacity = '0';
        card.style.transform = 'translateY(8px)';
        grid.prepend(card);
        requestAnimationFrame(() => {
          card.style.transition = 'opacity 0.22s ease, transform 0.22s ease';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        });
      };

      const updateMyRegistrationsPage = (eventId, isRegistered) => {
        const card = document.querySelector(`.my-reg-card [data-event-id="${eventId}"]`)?.closest('.my-reg-card');
        const grid = document.querySelector('.my-reg-grid');
        const shell = document.querySelector('.my-registrations-shell');

        if (!card) {
          return;
        }

        if (!isRegistered) {
          card.remove();
        }

        if (grid && grid.children.length === 0 && shell && !shell.querySelector('.my-reg-empty')) {
          const empty = document.createElement('div');
          empty.className = 'my-reg-empty';
          empty.innerHTML = `
            <p>You have not registered for any events yet.</p>
            <a href="{{ path('app_client_food_donation_calendar') }}" class="btn-register-link">Browse Events</a>
          `;
          grid.remove();
          shell.appendChild(empty);
        }
      };

      const notifyRecommendationsRefresh = (options = {}) => {
        document.dispatchEvent(new CustomEvent('recommendations:refresh', {
          detail: options,
        }));
      };

      const syncRegistrationState = async (options = {}) => {
        const shouldRefreshRecommendations = options.notifyRecommendations === true;
        const popup = document.getElementById('myRegisteredEventsPopup');
        if (!popup) {
          return;
        }

        try {
          const response = await fetch(REGISTRATION_STATE_ENDPOINT, {
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'Accept': 'application/json',
            },
          });

          if (!response.ok) {
            return;
          }

          const payload = await response.json();
          if (!payload || payload.success !== true) {
            return;
          }

          const registrationCounts = payload.registration_counts || {};
          Object.keys(registrationCounts).forEach((eventId) => {
            setRegistrationCount(Number(eventId), registrationCounts[eventId]);
          });

          const registeredEventIds = new Set((payload.registered_event_ids || []).map((id) => Number(id)));
          const eventMap = new Map((payload.my_events || []).map((event) => [Number(event.id || 0), event]));

          document.querySelectorAll('.event[data-event-id]').forEach((eventNode) => {
            const eventId = Number(eventNode.getAttribute('data-event-id') || 0);
            if (!eventId) {
              return;
            }

            const isRegistered = registeredEventIds.has(eventId);
            const eventData = eventMap.get(eventId);
            replaceEventCardRegisterState(eventId, isRegistered, String(eventData?.register_token || ''));
          });

          renderMyRegisteredEvents(payload.my_events || []);
          if (shouldRefreshRecommendations) {
            notifyRecommendationsRefresh({
              instant: true,
              forceLoading: true,
            });
          }
        } catch (error) {
          console.error('Registration sync failed:', error);
        }
      };

      const postEventAction = async ({ url, token }) => {
        const formData = new FormData();
        formData.append('_token', token);

        const response = await fetch(url, {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json',
          },
        });

        const payload = await response.json();
        if (!response.ok || !payload.success) {
          throw new Error(payload.message || 'Request failed.');
        }

        return payload;
      };

      const setInlineRegisterButtonLoading = (button, isLoading, loadingText = 'Registering...') => {
        if (!button) {
          return;
        }

        if (!button.dataset.defaultText) {
          button.dataset.defaultText = String(button.textContent || 'Register');
        }

        if (isLoading) {
          button.disabled = true;
          button.classList.add('is-registering');
          button.textContent = loadingText;
          return;
        }

        button.disabled = false;
        button.classList.remove('is-registering');
        button.textContent = button.dataset.defaultText;
      };

      document.addEventListener('submit', async (event) => {
        const form = event.target.closest('.js-event-register-form');
        if (!form) {
          return;
        }

        event.preventDefault();

        const submitButton = form.querySelector('button[type="submit"]');
        if (!submitButton) {
          return;
        }

        const eventId = Number(form.dataset.eventId || 0);
        const registerToken = String(form.querySelector('input[name="_token"]')?.value || '');
        setInlineRegisterButtonLoading(submitButton, true, 'Registering...');

        try {
          const payload = await postEventAction({
            url: form.action,
            token: registerToken,
          });

          setRegistrationCount(eventId, payload.registration_count ?? 0);
          replaceEventCardRegisterState(eventId, true, registerToken);
          upsertMyRegisteredEventCard(eventId, payload.registration_count ?? 0, payload.registered_event || null);
          showToast(payload.message || 'You are now registered for this event.', 'success');
          notifyRecommendationsRefresh({
            instant: true,
            forceLoading: true,
          });
          await syncRegistrationState({ notifyRecommendations: false });
        } catch (error) {
          setInlineRegisterButtonLoading(submitButton, false);
          showToast(error instanceof Error ? error.message : 'Registration failed. Please try again.', 'error');
        }
      });

      document.addEventListener('click', async (event) => {
        const modalUnregisterButton = event.target.closest('.js-unregister-btn');
        if (modalUnregisterButton && modalUnregisterButton.closest('#myRegisteredEventsPopup')) {
          event.preventDefault();
          event.stopPropagation();

          const eventId = modalUnregisterButton.dataset.eventId;
          const csrfToken = modalUnregisterButton.dataset.csrf || modalUnregisterButton.dataset.unregisterToken || '';
          const eventTitle = modalUnregisterButton.closest('.my-event-card')?.querySelector('.my-event-title')?.textContent || 'this event';

          if (!eventId || !csrfToken) {
            showToast('Unable to unregister right now. Please refresh and try again.', 'error');
            return;
          }

          const confirmModal = document.createElement('div');
          confirmModal.className = 'custom-confirm-modal';
          confirmModal.innerHTML = `
            <div class="custom-confirm-box">
              <h4>Unregister from "${escapeHtml(eventTitle)}"?</h4>
              <p>You will be removed from this event.</p>
              <div class="confirm-actions">
                <button class="confirm-cancel-btn" type="button">Cancel</button>
                <button class="confirm-proceed-btn" type="button">Unregister</button>
              </div>
            </div>
          `;

          document.body.appendChild(confirmModal);

          const closeConfirmModal = () => {
            if (confirmModal.parentNode) {
              confirmModal.remove();
            }
          };

          confirmModal.querySelector('.confirm-cancel-btn')?.addEventListener('click', closeConfirmModal);

          confirmModal.querySelector('.confirm-proceed-btn')?.addEventListener('click', async () => {
            modalUnregisterButton.disabled = true;
            modalUnregisterButton.textContent = 'Unregistering...';

            try {
              const response = await fetch(
                `{{ path('app_client_food_donation_unregister', {'id': 'PLACEHOLDER'}) }}`.replace('PLACEHOLDER', eventId),
                {
                  method: 'POST',
                  headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'Accept': 'application/json',
                  },
                  body: '_token=' + encodeURIComponent(csrfToken),
                }
              );

              const payload = await response.json();
              if (!response.ok || !payload.success) {
                throw new Error(payload.message || 'Failed to unregister. Please try again.');
              }

              const numericEventId = Number(eventId);
              setRegistrationCount(numericEventId, payload.registration_count ?? 0);

              const card = modalUnregisterButton.closest('.my-event-card');
              if (card) {
                card.style.transition = 'opacity 0.3s ease';
                card.style.opacity = '0';

                window.setTimeout(() => {
                  card.remove();
                  const popupGrid = document.querySelector('#myRegisteredEventsPopup .my-events-grid');
                  if (popupGrid && popupGrid.querySelectorAll('.my-event-card').length === 0) {
                    popupGrid.innerHTML = '<p class="empty-copy js-no-events-msg">You are not registered for any events yet.</p>';
                  }
                }, 300);
              }

              replaceEventCardRegisterState(numericEventId, false, String(modalUnregisterButton.dataset.registerToken || ''));
              updateMyRegistrationsPage(numericEventId, false);
              showToast(payload.message || 'You have been unregistered from this event.', 'success');
              document.dispatchEvent(new CustomEvent('recommendations:refresh', {
                detail: {
                  instant: true,
                  forceLoading: true,
                },
              }));
              await syncRegistrationState({ notifyRecommendations: false });
            } catch (error) {
              modalUnregisterButton.disabled = false;
              modalUnregisterButton.textContent = 'Unregister';
              showToast(error instanceof Error ? error.message : 'An error occurred. Please try again.', 'error');
            } finally {
              closeConfirmModal();
            }
          });

          confirmModal.addEventListener('click', (clickEvent) => {
            if (clickEvent.target === confirmModal) {
              closeConfirmModal();
            }
          });

          return;
        }

        const toggleButton = event.target.closest('.js-event-toggle-btn');
        if (!toggleButton) {
          return;
        }

        const eventId = Number(toggleButton.dataset.eventId || 0);
        const action = String(toggleButton.dataset.action || 'unregister').toLowerCase();
        const isRegisterAction = action === 'register';
        const actionUrl = isRegisterAction ? toggleButton.dataset.registerUrl : toggleButton.dataset.unregisterUrl;
        const token = isRegisterAction ? toggleButton.dataset.registerToken : toggleButton.dataset.unregisterToken;
        const previousText = toggleButton.textContent;

        if (!actionUrl || !token) {
          return;
        }

        toggleButton.disabled = true;
        toggleButton.textContent = 'Loading...';

        try {
          const payload = await postEventAction({ url: actionUrl, token });
          const isNowRegistered = Boolean(payload.registered);

          setRegistrationCount(eventId, payload.registration_count ?? 0);
          setButtonState(toggleButton, isNowRegistered ? 'unregister' : 'register');
          replaceEventCardRegisterState(eventId, isNowRegistered, String(toggleButton.dataset.registerToken || ''));
          updateMyRegistrationsPage(eventId, isNowRegistered);
          showToast(payload.message || 'Registration updated.', 'success');
          await syncRegistrationState({ notifyRecommendations: true });
        } catch (error) {
          toggleButton.textContent = previousText;
          showToast(error instanceof Error ? error.message : 'Action failed. Please try again.', 'error');
        } finally {
          toggleButton.disabled = false;
        }
      });

      syncRegistrationState();
      window.setInterval(syncRegistrationState, REGISTRATION_SYNC_MS);

      document.addEventListener('my-registrations:open', () => {
        syncRegistrationState();
      });

      document.addEventListener('registration-state-changed', (event) => {
        const detail = event.detail || {};
        const eventId = Number(detail.eventId || 0);

        if (eventId > 0) {
          const registrationCount = Number(detail.registrationCount || 0);
          const eventData = detail.event && typeof detail.event === 'object' ? detail.event : null;
          const registerToken = String(eventData?.register_token || '');

          setRegistrationCount(eventId, registrationCount);
          replaceEventCardRegisterState(eventId, true, registerToken);
          upsertMyRegisteredEventCard(eventId, registrationCount, eventData);
        }

        syncRegistrationState({ notifyRecommendations: false });
      });
    })();
  </script>
  <script>
    (function () {
      const STATUS_ENDPOINT = '/api/refresh-event-statuses';
      const INTERVAL_MS = 30000;

      const prettyLabel = (apiStatus) => {
        const mapping = {
          SCHEDULED: 'Scheduled',
          IN_PROGRESS: 'In Progress',
          ONGOING: 'Ongoing',
          COMPLETED: 'Completed',
          CANCELLED: 'Cancelled',
        };

        return mapping[apiStatus] || 'Scheduled';
      };

      const refreshStatuses = async () => {
        try {
          const response = await fetch(STATUS_ENDPOINT, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
          });

          if (!response.ok) {
            throw new Error('Refresh failed');
          }

          const data = await response.json();
          if (!data || data.success !== true || !Array.isArray(data.events)) {
            return;
          }

          data.events.forEach((eventItem) => {
            const row = document.querySelector(`[data-event-id="${eventItem.id}"]`);
            if (!row) {
              return;
            }

            const apiStatus = String(eventItem.status || 'SCHEDULED').toUpperCase();
            const statusNode = row.querySelector('[data-event-status]');
            if (statusNode) {
              statusNode.textContent = prettyLabel(apiStatus);
              statusNode.className = `status status-${apiStatus.toLowerCase()}`;
            }

            const registerWrapper = row.querySelector('[data-register-wrapper]');
            if (registerWrapper) {
              registerWrapper.style.display = apiStatus === 'SCHEDULED' ? '' : 'none';
            }
          });
        } catch (error) {
          console.error('Home event refresh failed:', error);
        }
      };

      refreshStatuses();
      setInterval(refreshStatuses, INTERVAL_MS);
    })();
  </script>
  <script>
    (function () {
      const gallery = document.querySelector('[data-menu-gallery]');
      if (!gallery) {
        return;
      }

      const grid = document.getElementById('menuCardsGrid');
      const prevButton = document.getElementById('menuPrevBtn');
      const nextButton = document.getElementById('menuNextBtn');
      const status = document.getElementById('menuGalleryStatus');
      const dots = document.getElementById('menuPageDots');
      const currencySelect = document.getElementById('menuCurrencySelect');
      const filterButtons = Array.from(document.querySelectorAll('[data-menu-filter]'));
      const fallbackImage = gallery.getAttribute('data-fallback-image') || '';
      const pageSize = Math.max(1, Number(gallery.getAttribute('data-page-size') || 4));
      const rates = { TND: 1, USD: 0.32, EUR: 0.30, CNY: 2.31 };

      let dishes = [];
      let currentPage = 1;
      let activeFilter = '__all__';
      let touchStartX = 0;

      try {
        dishes = JSON.parse(gallery.getAttribute('data-dishes') || '[]');
      } catch (error) {
        console.error('Menu gallery data is invalid.', error);
        dishes = [];
      }

      const escapeHtml = (value) => String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

      const normalizedCurrency = () => {
        const selected = String(currencySelect?.value || 'TND').toUpperCase();

        return Object.prototype.hasOwnProperty.call(rates, selected) ? selected : 'TND';
      };

      const filteredDishes = () => {
        if (activeFilter === '__all__') {
          return dishes;
        }

        return dishes.filter((dish) => String(dish.menuTitle || '') === activeFilter);
      };

      const totalPages = () => Math.max(1, Math.ceil(filteredDishes().length / pageSize));

      const convertPrice = (basePrice) => {
        const currency = normalizedCurrency();
        const amount = Number(basePrice || 0) * rates[currency];

        return `${amount.toFixed(2)} ${currency}`;
      };

      const renderDots = () => {
        const pages = totalPages();
        dots.innerHTML = '';

        for (let page = 1; page <= pages; page += 1) {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = String(page);
          button.className = 'menu-page-dot';
          button.style.cssText = `padding:.35rem .65rem;border-radius:999px;border:1px solid rgba(184,135,42,.18);background:${page === currentPage ? 'var(--gold)' : '#fff'};color:${page === currentPage ? '#fff' : 'var(--brown)'};font-weight:600;`;
          button.addEventListener('click', () => {
            currentPage = page;
            renderGallery();
          });
          dots.appendChild(button);
        }
      };

      const renderGallery = () => {
        const activeDishes = filteredDishes();
        const pages = Math.max(1, Math.ceil(activeDishes.length / pageSize));
        currentPage = Math.min(Math.max(1, currentPage), pages);

        const startIndex = (currentPage - 1) * pageSize;
        const visibleDishes = activeDishes.slice(startIndex, startIndex + pageSize);

        grid.innerHTML = visibleDishes.map((dish) => `
          <div class="menu-card reveal compact show">
            <div class="menu-card-inner">
              <div class="menu-thumb">
                <img
                  src="${escapeHtml(dish.imageUrl || fallbackImage)}"
                  alt="${escapeHtml(dish.name || 'Signature dish')}"
                  loading="lazy"
                  onerror="if (this.src !== '${escapeHtml(fallbackImage)}') { this.src='${escapeHtml(fallbackImage)}'; }"
                >
              </div>
              <div class="menu-card-content">
                <h4>${escapeHtml(dish.name || 'Signature dish')}</h4>
                <p class="short-desc">${escapeHtml(dish.description || 'Freshly prepared signature item from our kitchen.')}</p>
                <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:.75rem; margin-top:.85rem; flex-wrap:wrap;">
                  <div>
                    <span class="price" style="display:block;">${convertPrice(dish.basePrice)}</span>
                    <small style="display:block; margin-top:.2rem; color:var(--text-3);">${Number(dish.basePrice || 0).toFixed(2)} TND base price</small>
                  </div>
                  <button class="add-cart-btn" data-name="${escapeHtml(dish.name || 'Dish')}" data-price="${Number(dish.basePrice || 0).toFixed(2)}">Add to Cart</button>
                </div>
                <div style="margin-top:.45rem; color:var(--text-3); font-size:.72rem; letter-spacing:.08em; text-transform:uppercase;">
                  ${escapeHtml(dish.menuTitle || 'Chef Specials')}
                </div>
              </div>
            </div>
          </div>
        `).join('');

        prevButton.disabled = currentPage <= 1;
        nextButton.disabled = currentPage >= pages;
        prevButton.style.opacity = currentPage <= 1 ? '0.55' : '1';
        nextButton.style.opacity = currentPage >= pages ? '0.55' : '1';

        const label = activeFilter === '__all__' ? 'All menus' : activeFilter;
        status.textContent = activeDishes.length === 0
          ? `No dishes in ${label}`
          : `${label} • page ${currentPage} of ${pages} • ${activeDishes.length} dishes`;

        renderDots();
      };

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeFilter = button.getAttribute('data-menu-filter') || '__all__';
          currentPage = 1;

          filterButtons.forEach((item) => {
            item.classList.toggle('is-active', item === button);
            item.style.background = item === button ? 'var(--gold)' : 'rgba(255,255,255,.92)';
            item.style.color = item === button ? '#fff' : 'var(--brown)';
          });

          renderGallery();
        });
      });

      prevButton?.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage -= 1;
          renderGallery();
        }
      });

      nextButton?.addEventListener('click', () => {
        if (currentPage < totalPages()) {
          currentPage += 1;
          renderGallery();
        }
      });

      currencySelect?.addEventListener('change', renderGallery);

      grid?.addEventListener('touchstart', (event) => {
        touchStartX = event.changedTouches[0]?.clientX || 0;
      }, { passive: true });

      grid?.addEventListener('touchend', (event) => {
        const touchEndX = event.changedTouches[0]?.clientX || 0;
        const deltaX = touchEndX - touchStartX;

        if (Math.abs(deltaX) < 40) {
          return;
        }

        if (deltaX < 0 && currentPage < totalPages()) {
          currentPage += 1;
          renderGallery();
        }

        if (deltaX > 0 && currentPage > 1) {
          currentPage -= 1;
          renderGallery();
        }
      }, { passive: true });

      renderGallery();
    })();
  </script>
  <script>
    (function () {
      const shell = document.querySelector('[data-menu-assistant]');
      if (!shell) {
        return;
      }

      const toggle = shell.querySelector('#moodChatToggle');
      const panel = shell.querySelector('#moodChatPanel');
      const messages = shell.querySelector('#moodChatMessages');
      const form = shell.querySelector('#moodChatForm');
      const input = shell.querySelector('#moodChatInput');
      const quickButtons = shell.querySelectorAll('[data-prompt]');
      const aiEndpoint = shell.getAttribute('data-ai-endpoint') || '';

      let dishes = [];

      try {
        dishes = JSON.parse(shell.getAttribute('data-dishes') || '[]');
      } catch (error) {
        dishes = [];
      }

      const escapeHtml = (value) => String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

      const scoreDish = (dish, query) => {
        const q = String(query || '').toLowerCase();
        const haystack = [
          dish.name,
          dish.description,
          dish.menuTitle,
        ].join(' ').toLowerCase();

        let score = 0;

        if (q.includes('sweet') || q.includes('dessert')) {
          if (/(sweet|dessert|chocolate|caramel|vanilla|cream)/.test(haystack)) {
            score += 5;
          }
        }

        if (q.includes('coffee') || q.includes('espresso') || q.includes('drink')) {
          if (/(coffee|espresso|latte|mocha|cappuccino)/.test(haystack)) {
            score += 5;
          }
        }

        if (q.includes('light') || q.includes('fresh') || q.includes('healthy')) {
          if (/(light|fresh|salad|grilled|fruit)/.test(haystack)) {
            score += 5;
          }
        }

        if (q.includes('premium') || q.includes('signature') || q.includes('luxury')) {
          score += 3;
        }

        q.split(/\s+/).filter(Boolean).forEach((word) => {
          if (haystack.includes(word)) {
            score += 2;
          }
        });

        if (score === 0) {
          score = Math.max(1, 20 - Number(dish.basePrice || 0));
        }

        return score;
      };

      const openPanel = () => {
        panel.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
      };

      const appendMessage = (content, role = 'assistant') => {
        const node = document.createElement('div');
        node.className = `mood-chat-msg ${role}`;
        node.innerHTML = content;
        messages.appendChild(node);
        messages.scrollTop = messages.scrollHeight;
        return node;
      };

      const buildDishCard = (dish, reason) => `
        <div class="mood-chat-dish-card">
          <h5>${escapeHtml(dish.name || 'Signature dish')}</h5>
          <p class="dish-desc">${escapeHtml(dish.description || 'Freshly prepared from our current menu.')}</p>
          <p class="dish-reason">${escapeHtml(reason)}</p>
          <span class="dish-price">${Number(dish.basePrice || 0).toFixed(2)} TND · ${escapeHtml(dish.menuTitle || 'Chef Specials')}</span>
        </div>
      `;

      const suggestDishes = (query) => {
        if (!Array.isArray(dishes) || dishes.length === 0) {
          return [];
        }

        return [...dishes]
          .map((dish) => ({ dish, score: scoreDish(dish, query) }))
          .sort((left, right) => right.score - left.score)
          .slice(0, 3)
          .map(({ dish }, index) => ({
            ...dish,
            reason: index === 0
              ? `Best match for "${query}".`
              : `Also a good fit for "${query}".`,
          }));
      };

      const askBackendAi = async (query, picks) => {
        if (!aiEndpoint) {
          return null;
        }

        const menuSummary = picks.map((dish) => `${dish.name} (${dish.menuTitle})`).join(', ');
        const question = menuSummary
          ? `${query}. Current best menu matches: ${menuSummary}. Keep the answer short and mention food suggestions.`
          : query;

        const response = await fetch(aiEndpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
          body: JSON.stringify({ question }),
        });

        if (!response.ok) {
          throw new Error('AI request failed.');
        }

        const payload = await response.json();
        return payload && payload.success ? String(payload.answer || '').trim() : null;
      };

      const handleSuggestion = async (query) => {
        const normalized = String(query || '').trim();
        if (normalized === '') {
          return;
        }

        openPanel();
        appendMessage(escapeHtml(normalized), 'user');

        const picks = suggestDishes(normalized);
        if (picks.length > 0) {
          appendMessage(picks.map((dish) => buildDishCard(dish, dish.reason)).join(''), 'assistant');
        } else {
          appendMessage('I could not match that exactly, but the menu is loaded and ready. Try sweet, light, coffee, or signature.', 'assistant');
        }

        const loadingNode = appendMessage('Thinking...', 'assistant loading');

        try {
          const aiText = await askBackendAi(normalized, picks);
          loadingNode.className = 'mood-chat-msg assistant';
          loadingNode.innerHTML = escapeHtml(aiText || 'Based on the current menu, I recommend the dishes shown above for your request.');
        } catch (error) {
          loadingNode.className = 'mood-chat-msg assistant';
          loadingNode.innerHTML = 'The AI service is unavailable right now, but the menu suggestions above are ready for the validation demo.';
        }
      };

      toggle?.addEventListener('click', () => {
        const willOpen = panel.hidden;
        panel.hidden = !willOpen;
        toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        if (willOpen) {
          window.setTimeout(() => input?.focus(), 60);
        }
      });

      quickButtons.forEach((button) => {
        button.addEventListener('click', () => {
          void handleSuggestion(button.getAttribute('data-prompt') || '');
        });
      });

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const query = input?.value || '';
        if (input) {
          input.value = '';
        }
        void handleSuggestion(query);
      });
    })();
  </script>
  {% endblock %}
</body>
</html>
