  function appendFloatingAiMessage(role, text) {
    if (!floatingAiLog || !text) {
      return;
    }

    const row = document.createElement('div');
    row.style.display = 'flex';
    row.style.justifyContent = role === 'user' ? 'flex-end' : 'flex-start';

    const bubble = document.createElement('div');
    bubble.style.maxWidth = '90%';
    bubble.style.padding = '.48rem .68rem';
    bubble.style.borderRadius = '12px';
    bubble.style.fontSize = '.79rem';
    bubble.style.lineHeight = '1.35';
    bubble.style.whiteSpace = 'pre-wrap';
    bubble.style.background = role === 'user' ? 'linear-gradient(135deg,#b8872a,#9a6f1f)' : 'rgba(245,240,231,.95)';
    bubble.style.color = role === 'user' ? '#fff' : 'var(--espresso)';
    bubble.style.border = role === 'user' ? 'none' : '1px solid rgba(184,135,42,.2)';
    bubble.textContent = text;

    row.appendChild(bubble);
    floatingAiLog.appendChild(row);
    floatingAiLog.scrollTop = floatingAiLog.scrollHeight;
  }

