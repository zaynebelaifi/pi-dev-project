  async function translateBookingCopy(text, targetLanguage) {
    const normalizedText = String(text || '').trim();
    const normalizedLanguage = String(targetLanguage || 'en').trim();

    if (!normalizedText || !normalizedLanguage || normalizedLanguage === 'en') {
      return normalizedText;
    }

    try {
      const response = await fetch('{{ path("app_ai_bot_translate") }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          text: normalizedText,
          language: normalizedLanguage,
        }),
      });

      const data = await response.json();
      if (!response.ok || !data.success || typeof data.translation !== 'string' || !data.translation.trim()) {
        return normalizedText;
      }

      return data.translation;
    } catch (error) {
      return normalizedText;
    }
  }

