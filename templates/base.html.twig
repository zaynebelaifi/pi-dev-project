  async function askFloatingAssistant(question) {
    const text = String(question || '').trim();
    if (!text) {
      return;
    }

    appendFloatingAiMessage('user', text);
    setFloatingAiBusy(true);

    try {
      const res = await fetch('{{ path("app_ai_bot_ask") }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question: text }),
      });

      const data = await res.json();
      if (!data.success) {
        appendFloatingAiMessage('assistant', data.message || 'I could not respond right now.');
        return;
      }

