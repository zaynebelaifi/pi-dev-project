<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}BIG 4 - Ultra Luxury Coffee Lounge{% endblock %}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Jost:wght@300;400;500;600&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link rel="stylesheet" href="/styles/app.css?v=6">
</head>
<body>
  <!-- NAV -->
  <nav id="nav">
    <div class="nav-inner">
      <a href="{{ path('app_home') }}" class="brand">
        <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" alt="BIG 4 logo" style="display:none">
        <div>
          <h1>BIG 4</h1>
          <span>Coffee Lounge</span>
        </div>
      </a>

      <ul class="nav-links">
        <li><a href="{{ path('app_home') }}#menu-section">MENU</a></li>
        <li><a href="{{ path('app_home') }}#delivery">DELIVERY</a></li>
        <li><a href="{{ path('app_home') }}#events">EVENTS</a></li>
      </ul>

      {% set user_role = app.request.session.get('user_role') %}
      {% set user_name = app.request.session.get('user_name') %}
      {% set user_email = app.request.session.get('user_email') %}
      {% set user_phone = app.request.session.get('user_phone') %}
      {% set user_address = app.request.session.get('user_address') %}
      {% set session_user_id = app.request.session.get('user_id') %}
      {% set normalized_role = (user_role ?: '')|upper %}
      {% set is_customer = is_granted('ROLE_CUSTOMER') or is_granted('ROLE_CLIENT') or normalized_role in ['ROLE_CLIENT', 'ROLE_CUSTOMER'] %}
      {% set is_authenticated = is_granted('IS_AUTHENTICATED_FULLY') or session_user_id is not empty %}
      <div class="nav-actions">
        <button class="cart-btn" id="openCart">
          CART <span class="cart-badge" id="cartCount">0</span>
        </button>
        <button class="profile-btn" id="openProfile">PROFILE</button>
        <a href="#" class="nav-btn" id="openBooking">BOOK NOW</a>
        {% if user_role == 'ROLE_ADMIN' %}
          <a href="{{ path('app_admin_dashboard') }}" class="nav-btn">Admin</a>
          <form method="post" action="{{ path('app_logout') }}" style="display:inline-flex; margin:0;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="nav-btn" style="border:none;">Logout</button>
          </form>
        {% elseif user_role == 'ROLE_DELIVERY_MAN' %}
          <a href="{{ path('app_driver_deliveries') }}" class="nav-btn">My Deliveries</a>
          <form method="post" action="{{ path('app_logout') }}" style="display:inline-flex; margin:0;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="nav-btn" style="border:none;">Logout</button>
          </form>
        {% elseif user_role == 'ROLE_CLIENT' %}
          <a href="{{ path('app_profile') }}" class="nav-btn">MY PROFILE</a>
          <a href="{{ path('app_client_orders') }}" class="nav-btn">MY ORDERS</a>
          <form method="post" action="{{ path('app_logout') }}" style="display:inline-flex; margin:0;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="nav-btn" style="border:none;">LOGOUT</button>
          </form>
        {% else %}
          <a href="{{ path('app_login') }}" class="nav-btn">Login</a>
        {% endif %}
      </div>
    </div>
  </nav>

  <!-- FLASH MESSAGES -->
  {% for message in app.flashes('error') %}
    <div class="flash-message flash-error" data-flash>
      {{ message }}
    </div>
  {% endfor %}
  {% for message in app.flashes('success') %}
    <div class="flash-message flash-success" data-flash>
      {{ message }}
    </div>
  {% endfor %}

  {% block body %}
  <!-- HERO -->
  <section class="hero" id="home">
    <div class="container hero-grid">
      <div class="reveal-left show">
        <div class="eyebrow">Tunis - Elevated Dining & Coffee</div>
        <h2>Where Coffee Meets <em>Luxury</em></h2>
        <div class="hero-sub">BIG 4 Coffee Lounge</div>
        <p class="lead">A refined escape for coffee lovers, dinner guests, and late-evening conversations - designed with warmth, elegance, and unforgettable atmosphere.</p>
        <div class="hero-actions">
          <a href="#" class="btn-primary" id="openBooking2">Reserve a Table</a>
          <a href="#gallery" class="btn-secondary">Discover the Space</a>
        </div>
      </div>

      <div class="hero-card reveal-right show">
        <small>Signature Experience</small>
        <h3>Modern Lounge Dining</h3>
        <p>From handcrafted espresso to intimate dinners and curated evenings, BIG 4 blends contemporary luxury with timeless hospitality.</p>
        <div class="hero-stats">
          <div><strong>4.9</strong><span>Guest Rating</span></div>
          <div><strong>48</strong><span>Signature Items</span></div>
          <div><strong>30m</strong><span>Fast Delivery</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <div class="container about-grid">
      <div class="about-image reveal-left">
        <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1200&q=80" alt="Luxury restaurant interior">
      </div>
      <div class="about-panel reveal-right">
        <small class="eyebrow" style="margin-bottom:1rem">Our Story</small>
        <h3 style="font-family:'Cormorant Garamond',serif;font-size:3.2rem;font-weight:300;line-height:1.05;color:var(--espresso)">A Space Crafted for <span style="color:var(--gold);font-style:italic">Taste & Atmosphere</span></h3>
        <p>BIG 4 was imagined as more than a cafe - a destination where refined design, gourmet flavors, and ambient evenings come together. Every detail is curated to feel elegant, intimate, and memorable.</p>
        <div class="stats-grid">
          <div class="stat"><strong>2023</strong><span>Founded in Tunis</span></div>
          <div class="stat"><strong>1.2K+</strong><span>Loyal Guests</span></div>
          <div class="stat"><strong>Midnight</strong><span>Open Until</span></div>
          <div class="stat"><strong>Private</strong><span>Reservations</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="features">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <small>Signature Offerings</small>
          <h3>Curated for a <em>Premium</em> Experience</h3>
        </div>
        <p>Every service is designed to feel polished, elevated, and indulgent - whether you're dining in, reserving for a special night, or ordering from home.</p>
      </div>

      <div class="cards">
        <div class="card reveal">
          <div class="number">01</div>
          <h4>Refined Menu</h4>
          <p>Specialty coffee, elegant desserts, gourmet plates, and signature beverages created to satisfy both daytime cravings and evening indulgence.</p>
        </div>
        <div class="card reveal">
          <div class="number">02</div>
          <h4>Private Reservations</h4>
          <p>Reserve your table for intimate dinners, stylish gatherings, business meetings, or a relaxed evening in a luxurious setting.</p>
        </div>
        <div class="card reveal">
          <div class="number">03</div>
          <h4>Luxury Delivery</h4>
          <p>Enjoy the BIG 4 experience at home with carefully packaged orders, prompt delivery, and presentation that feels premium.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOD MENU -->
  <section id="menu-section">
    <div class="container">
      {% set flattenedMenuDishes = flatMenuItems|default([]) %}
      <div class="section-head reveal">
        <div>
          <small>Luxury Menu</small>
          <h3>Signature <em>Flavours</em> of BIG 4</h3>
        </div>
        <p>A polished menu designed for coffee lovers, brunch guests, and elegant dining moments.</p>
      </div>

      {% if menuSections is defined and menuSections is not empty %}
        {# Count total available dishes across sections #}
        {% set totalDishes = 0 %}
        {% for section in menuSections %}
          {% set totalDishes = totalDishes + (section.dishes is defined ? section.dishes|length : 0) %}
        {% endfor %}

        {# If there are any dishes, render a consolidated Main Menu first so the page shows items clearly #}
        {% if totalDishes > 0 %}
          <div style="margin:1.2rem 0 .7rem;">
            <h4 style="font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:500;color:var(--espresso);margin:0;">Main Menu</h4>
            <p style="margin:.25rem 0 0;color:var(--text-2);">All available dishes</p>
          </div>

          {% set fallbackImage = 'https://placehold.co/900x600/f3eadb/6b4b28?text=BIG+4+Dish' %}
          <div
            class="menu-gallery-shell"
            data-menu-gallery
            data-dishes="{{ flattenedMenuDishes|json_encode|e('html_attr') }}"
            data-fallback-image="{{ fallbackImage|e('html_attr') }}"
            data-page-size="{{ menuPageSize|default(4) }}"
          >
            <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:1rem;">
              <div style="display:flex; align-items:center; gap:.75rem; flex-wrap:wrap;">
                <label for="menuCurrencySelect" style="font-weight:600; color:var(--brown);">Currency</label>
                <select id="menuCurrencySelect" style="padding:.55rem .8rem; border-radius:999px; border:1px solid rgba(184,135,42,.18); background:#fff; color:var(--brown);">
                  <option value="TND">TND</option>
                  <option value="USD">USD</option>
                  <option value="EUR">EUR</option>
                  <option value="CNY">CNY</option>
                </select>
              </div>
              <div id="menuGalleryStatus" style="color:var(--text-2); padding:0.5rem 1rem; border-radius:8px; background:var(--ivory-2);">
                Showing menu
              </div>
            </div>

            <div id="menuCardsGrid" class="menu-paged-grid" aria-live="polite"></div>

            <div style="margin-top:1.25rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
              <div style="display:flex; align-items:center; gap:.75rem; flex-wrap:wrap;">
                <button type="button" id="menuPrevBtn" class="nav-btn" style="padding:.55rem 1rem;">Previous</button>
                <div id="menuPageDots" style="display:flex; align-items:center; gap:.45rem; flex-wrap:wrap;"></div>
                <button type="button" id="menuNextBtn" class="nav-btn" style="padding:.55rem 1rem;">Next</button>
              </div>
              <div style="color:var(--text-3); font-size:.92rem;">
                Swipe left or right on the dishes to move between pages.
              </div>
            </div>
          </div>

          {# Instead of repeating dishes, show a compact category list linking to sections. #}
          <div style="margin:1.2rem 0 .7rem;">
            <h5 style="font-family:'Cormorant Garamond',serif;font-size:1.25rem;font-weight:500;color:var(--espresso);margin:0 0 .5rem;">Categories</h5>
            <div class="menu-categories" style="display:flex;flex-wrap:wrap;gap:.6rem">
              <button type="button" class="menu-category is-active" data-menu-filter="__all__" style="padding:.5rem .8rem;border:1px solid rgba(184,135,42,.12);border-radius:999px;background:rgba(255,255,255,.92);color:var(--brown);text-decoration:none;font-weight:600">All ({{ flattenedMenuDishes|length }})</button>
              {% for section in menuSections %}
                {% if section.dishes is defined and section.dishes|length > 0 %}
                  <button type="button" class="menu-category" data-menu-filter="{{ section.menu.title|e('html_attr') }}" style="padding:.5rem .8rem;border:1px solid rgba(184,135,42,.12);border-radius:999px;background:rgba(255,255,255,.92);color:var(--brown);text-decoration:none;font-weight:600">{{ section.menu.title }} ({{ section.dishes|length }})</button>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% else %}
          <div class="menu-grid">
            <div class="menu-card reveal">
              <div class="menu-card-content">
                <h4>Menu Coming Soon</h4>
                <p>Our dishes are being updated right now. Please check back shortly.</p>
                <span class="price">--</span>
              </div>
            </div>
          </div>
        {% endif %}
      {% else %}
        <div class="menu-grid">
          <div class="menu-card reveal">
            <div class="menu-card-content">
              <h4>Menu Coming Soon</h4>
              <p>Our dishes are being updated right now. Please check back shortly.</p>
              <span class="price">--</span>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </section>

  <!-- GALLERY -->
  <section id="gallery">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <small>Visual Atmosphere</small>
          <h3>Inside the <em>BIG 4</em> Experience</h3>
        </div>
        <p>Elegant interiors, signature drinks, and warm lighting - a destination designed to feel cinematic and unforgettable.</p>
      </div>
      <div class="gallery-grid">
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1200&q=80" alt="Luxury lounge interior"><span>Elegant Lounge Ambience</span></div>
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=900&q=80" alt="Coffee presentation"><span>Signature Coffee</span></div>
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=900&q=80" alt="Restaurant table setup"><span>Fine Dining Touch</span></div>
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1515669097368-22e68427d265?auto=format&fit=crop&w=900&q=80" alt="Dessert plating"><span>Curated Desserts</span></div>
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1521017432531-fbd92d768814?auto=format&fit=crop&w=900&q=80" alt="Elegant drinks"><span>Evening Signatures</span></div>
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=900&q=80" alt="Food"><span>Luxury Dining</span></div>
      </div>
    </div>
  </section>

  <!-- DELIVERY -->
  <section id="delivery">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <small>Fast Service</small>
          <h3>Elegant <em>Delivery</em> at Your Door</h3>
        </div>
        <p>Enjoy BIG 4 from the comfort of your home with premium packaging, stylish presentation, and carefully delivered orders.</p>
      </div>

      <div class="cards">
        <div class="card reveal"><div class="number">01</div><h4>Fast Arrival</h4><p>Freshly prepared items delivered promptly while preserving temperature, presentation, and taste.</p></div>
        <div class="card reveal"><div class="number">02</div><h4>Premium Packaging</h4><p>Luxury-inspired packaging designed to keep your order elegant and intact from our lounge to your table.</p></div>
        <div class="card reveal"><div class="number">03</div><h4>Easy Ordering</h4><p>A seamless experience for coffee, desserts, and signature dishes whenever you want BIG 4 at home.</p></div>
      </div>
    </div>
  </section>

  <!-- EVENTS -->
  <section id="events">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <small>Upcoming Moments</small>
          <h3>Events & <em>Exclusive Nights</em></h3>
        </div>
        <p>Open the donation calendar, pick an event, and leave your rating directly from the event detail page.</p>
      </div>
      <div class="event-list">
        <a class="event event-card-link reveal" href="{{ path('app_client_food_donation_calendar') }}">
          <div class="date">
            <strong>All</strong>
            <span>Calendar</span>
          </div>
          <div>
            <h5>Food Donation Calendar</h5>
            <p>Click anywhere on this card to open the calendar page.</p>
          </div>
        </a>

        {% if donationEvents is defined and donationEvents is not empty %}
          {% for event in donationEvents %}
            {% set eventDate = event.eventDate %}
            {% set eventStatus = event.status ?: 'Scheduled' %}
            {% set eventStatusKey = eventStatus|lower %}
            {% set eventStatusApiClass = eventStatusKey == 'in progress' ? 'in_progress' : eventStatusKey %}
            <div class="event reveal" data-event-id="{{ event.donationEventId }}">
              <div class="date">
                <strong>{{ eventDate ? eventDate|date('d') : '--' }}</strong>
                <span>{{ eventDate ? eventDate|date('M') : 'TBD' }}</span>
              </div>
              <div>
                <h5>{{ event.charityName ?: ('Event #' ~ event.donationEventId) }}</h5>
                <p>
                  {{ eventDate ? eventDate|date('F j, Y H:i') : 'Date to be announced' }}
                  · {{ event.totalQuantity }} items
                  · <span data-registration-count-for="{{ event.donationEventId }}">{{ registrationCounts[event.donationEventId]|default(0) }}</span> registered
                  · <span class="status status-{{ eventStatusApiClass }}" data-event-status>{{ eventStatus }}</span>
                  {% if event.deliveryId %}· Delivery #{{ event.deliveryId }}{% endif %}
                </p>
                {% if eventStatusKey == 'scheduled' %}
                  <div
                    class="event-inline-actions"
                    data-register-wrapper
                    data-registered="{{ event.donationEventId in (registeredEventIds|default([])) ? '1' : '0' }}"
                    data-register-token="{{ csrf_token('register-event' ~ event.donationEventId) }}"
                    data-unregister-token="{{ csrf_token('unregister-event' ~ event.donationEventId) }}"
                  >
                    {% if is_customer %}
                      {% if event.donationEventId in (registeredEventIds|default([])) %}
                        <div class="registered-badge">
                          <span>Registered</span>
                        </div>
                      {% else %}
                        <div class="register-status">
                          <span class="status-badge">SCHEDULED</span>
                          <span class="registered-count">{{ registrationCounts[event.donationEventId]|default(0) }} registered</span>
                        </div>
                        <form method="post" action="{{ path('app_client_food_donation_register', {'id': event.donationEventId}) }}" class="js-event-register-form" data-event-id="{{ event.donationEventId }}">
                          <input type="hidden" name="_token" value="{{ csrf_token('register-event' ~ event.donationEventId) }}">
                          <button type="submit" class="event-register-btn-ui">Register</button>
                        </form>
                      {% endif %}
                    {% elseif not is_authenticated %}
                      <a href="{{ path('app_login') }}" class="event-register-btn-ui">Login to Register</a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="event reveal">
            <div class="date"><strong>--</strong><span>--</span></div>
            <div>
              <h5>No donation events yet</h5>
              <p>New food donation events will appear here as soon as they are created.</p>
            </div>
          </div>
        {% endif %}
      </div>

      {% if is_customer %}
        <div class="my-registered-events-cta">
          <button type="button" class="btn-secondary" id="openMyRegisteredEvents">My Registered Events</button>
        </div>
      {% endif %}
    </div>
  </section>

  <!-- AI RECOMMENDATIONS SECTION -->
  {% if is_customer %}
    <section class="recommended-events-section" id="ai-recommendations">
      <div class="container">
        <div class="section-head reveal">
          <div>
            <small>Personalized With AI</small>
            <h3><span class="ai-badge">AI Picks For You</span> Recommended <em>Events</em></h3>
          </div>
          <p class="recommended-subtitle">Based on events you have registered for before.</p>
        </div>

        <div
          id="recommendations"
          data-recommended-events
          class="event-list events-container"
          data-authenticated="{{ is_authenticated ? '1' : '0' }}"
          data-user-role="{{ is_customer ? 'ROLE_CUSTOMER' : (app.request.session.get('user_role') ?: '') }}"
        >
          <div class="event reveal">
            <p>Loading recommendations...</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ai-reviews-section" id="ai-reviews" data-ai-reviews-base="/feedback">
      <div class="container">
        <div class="section-head reveal ai-reviews-head">
          <div>
            <small>Guest Voices</small>
            <h3>AI-Verified <em>Testimonials</em></h3>
          </div>
          <p class="recommended-subtitle">Every review is analyzed by our AI feedback system to highlight standout experiences and flag support needs instantly.</p>
        </div>

        <div class="ai-review-toolbar reveal">
          <div class="ai-review-toggle">
            <button type="button" class="ai-review-toggle-btn active" data-ai-view="testimonials">⭐ Testimonials</button>
          </div>
          <div class="ai-review-filters" role="tablist" aria-label="Review filters">
            <button type="button" class="ai-review-filter active" data-ai-filter="all">All</button>
            <button type="button" class="ai-review-filter" data-ai-filter="5">5 Stars</button>
            <button type="button" class="ai-review-filter" data-ai-filter="4">4 Stars</button>
            <button type="button" class="ai-review-filter" data-ai-filter="fast">Fast Delivery</button>
            <button type="button" class="ai-review-filter" data-ai-filter="packaging">Great Packaging</button>
          </div>
          <div class="ai-review-pagination" aria-label="Review pagination">
            <button type="button" class="ai-review-page-btn" data-ai-page-action="prev">Prev</button>
            <span class="ai-review-page-indicator" id="aiReviewsPageIndicator">Page 1 of 1</span>
            <button type="button" class="ai-review-page-btn" data-ai-page-action="next">Next</button>
          </div>
        </div>

        <div class="ai-review-grid" id="aiReviewsGrid" data-ai-reviews-grid>
          <div class="ai-review-loading">Loading guest reviews...</div>
        </div>
        <div class="ai-reviews-empty" id="aiReviewsEmpty" style="display:none;">
          No guest reviews available yet. Check back soon!
        </div>
      </div>
    </section>
    <script>
      (function () {
        const section = document.getElementById('ai-reviews');
        const grid = document.getElementById('aiReviewsGrid');
        const emptyState = document.getElementById('aiReviewsEmpty');
        const indicator = document.getElementById('aiReviewsPageIndicator');
        if (!section || !grid) {
          return;
        }

        const state = {
          testimonials: [],
          filtered: [],
          filter: 'all',
          page: 1,
          perPage: 3,
        };

        const fallbackTestimonials = [
          {
            customer_name: 'Amira',
            review_text: 'Super fast delivery and elegant packaging.',
            summary: 'Fast delivery with premium presentation.',
            rating: 5,
          },
          {
            customer_name: 'Zayd',
            review_text: 'Coffee arrived hot and beautifully boxed.',
            summary: 'Warm coffee and beautiful boxing.',
            rating: 5,
          },
          {
            customer_name: 'Salma',
            review_text: 'Quick service with a smooth handoff.',
            summary: 'Efficient handoff and quick service.',
            rating: 4,
          },
        ];

        function esc(value) {
          return String(value ?? '').replace(/[&<>"]+/g, (char) => {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' };
            return map[char] || char;
          });
        }

        function stars(rating) {
          const rounded = Math.round(Number(rating) || 0);
          return Array.from({ length: 5 }, (_, index) => (index < rounded ? '★' : '☆')).join('');
        }

        function mentions(review) {
          const text = `${review.review_text || ''} ${review.summary || ''}`.toLowerCase();
          const words = [];
          const map = [
            ['fast', 'fast delivery'],
            ['delivery', 'delivery'],
            ['packaging', 'packaging'],
            ['ambiance', 'ambiance'],
            ['dessert', 'dessert'],
            ['service', 'service'],
            ['brunch', 'brunch'],
            ['coffee', 'coffee'],
            ['comfort', 'comfort'],
            ['menu', 'menu'],
            ['chef', 'chef'],
            ['pacing', 'pacing'],
          ];
          map.forEach(([needle, label]) => {
            if (text.includes(needle) && !words.includes(label)) {
              words.push(label);
            }
          });
          return words.slice(0, 3);
        }

        function matches(review, filter) {
          if (filter === 'all') return true;
          const text = `${review.review_text || ''} ${review.summary || ''}`.toLowerCase();
          const rating = Math.round(Number(review.rating) || 0);
          if (filter === '5') return rating >= 5;
          if (filter === '4') return rating === 4;
          if (filter === 'fast') return text.includes('fast') || text.includes('delivery');
          if (filter === 'packaging') return text.includes('packaging') || text.includes('boxed');
          return true;
        }

        function render() {
          state.filtered = state.testimonials.filter((review) => matches(review, state.filter));
          const totalPages = Math.max(1, Math.ceil(state.filtered.length / state.perPage));
          state.page = Math.min(state.page, totalPages);
          const start = (state.page - 1) * state.perPage;
          const visible = state.filtered.slice(start, start + state.perPage);

          if (indicator) {
            indicator.textContent = `Page ${state.page} of ${totalPages}`;
          }

          if (!visible.length) {
            grid.innerHTML = '';
            if (emptyState) emptyState.style.display = 'block';
            return;
          }

          if (emptyState) emptyState.style.display = 'none';
          grid.innerHTML = visible.map((review) => {
            const initial = esc((review.customer_name || 'G').trim().charAt(0).toUpperCase());
            const title = esc(review.summary || 'Guest review');
            const comment = esc(review.review_text || '');
            const summary = esc(review.summary || '');
            const rating = Number(review.rating) || 0;
            const tagList = mentions(review);

            return `
              <article class="ai-review-card reveal">
                <div class="ai-review-head">
                  <div class="ai-review-profile">
                    <div class="ai-review-avatar">${initial}</div>
                    <div>
                      <h4 class="ai-review-name">${esc(review.customer_name || 'Guest')}</h4>
                      <div class="ai-review-stars">${stars(rating)}</div>
                    </div>
                  </div>
                  <span class="ai-review-badge">AI Verified</span>
                </div>
                <h4 class="ai-review-title">${title}</h4>
                <p class="ai-review-comment">${comment}</p>
                <div class="ai-review-summary">${summary}</div>
                <div class="ai-review-tags">
                  <span class="ai-review-tag">${Math.round(rating)} Stars</span>
                  <span class="ai-review-tag">Verified</span>
                  ${tagList.map((tag) => `<span class="ai-review-tag">${esc(tag)}</span>`).join('')}
                </div>
              </article>
            `;
          }).join('');
        }

        async function load() {
          try {
            const response = await fetch('/feedback/testimonials', { headers: { Accept: 'application/json' } });
            if (!response.ok) {
              throw new Error(`API returned ${response.status}`);
            }
            const payload = await response.json();
            state.testimonials = Array.isArray(payload) && payload.length ? payload : fallbackTestimonials;
          } catch (error) {
            state.testimonials = fallbackTestimonials;
          }

          render();
        }

        document.querySelectorAll('[data-ai-filter]').forEach((button) => {
          button.addEventListener('click', () => {
            document.querySelectorAll('[data-ai-filter]').forEach((item) => item.classList.remove('active'));
            button.classList.add('active');
            state.filter = button.dataset.aiFilter || 'all';
            state.page = 1;
            render();
          });
        });

        document.querySelectorAll('[data-ai-page-action]').forEach((button) => {
          button.addEventListener('click', () => {
            const totalPages = Math.max(1, Math.ceil(state.filtered.length / state.perPage));
            if (button.dataset.aiPageAction === 'next') {
              state.page = Math.min(totalPages, state.page + 1);
            } else {
              state.page = Math.max(1, state.page - 1);
            }
            render();
          });
        });

        load();
      })();
    </script>
