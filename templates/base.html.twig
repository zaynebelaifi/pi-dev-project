<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}BIG 4 - Ultra Luxury Coffee Lounge{% endblock %}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Jost:wght@300;400;500;600&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link rel="stylesheet" href="/styles/app.css?v=5">
</head>
<body>
  <!-- NAV -->
  <nav id="nav">
    <div class="nav-inner">
      <a href="{{ path('app_home') }}" class="brand">
        <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" alt="BIG 4 logo" style="display:none">
        <div>
          <h1>BIG 4</h1>
          <span>Coffee Lounge</span>
        </div>
      </a>

      <ul class="nav-links">
        <li><a href="{{ path('app_home') }}#menu-section">MENU</a></li>
        <li><a href="{{ path('app_home') }}#delivery">DELIVERY</a></li>
        <li><a href="{{ path('app_home') }}#events">EVENTS</a></li>
      </ul>

      {% set user_role = app.request.session.get('user_role') %}
      {% set user_name = app.request.session.get('user_name') %}
      {% set user_email = app.request.session.get('user_email') %}
      {% set user_phone = app.request.session.get('user_phone') %}
      {% set user_address = app.request.session.get('user_address') %}
      {% set is_customer = is_granted('ROLE_CUSTOMER') or is_granted('ROLE_CLIENT') %}
      {% set is_authenticated = is_granted('IS_AUTHENTICATED_FULLY') %}
      <div class="nav-actions">
        <button class="cart-btn" id="openCart">
          CART <span class="cart-badge" id="cartCount">0</span>
        </button>
        <button class="profile-btn" id="openProfile">PROFILE</button>
        <a href="#" class="nav-btn" id="openBooking">BOOK NOW</a>
        {% if user_role == 'ROLE_ADMIN' %}
          <a href="{{ path('app_admin_dashboard') }}" class="nav-btn">Admin</a>
          <form method="post" action="{{ path('app_logout') }}" style="display:inline-flex; margin:0;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="nav-btn" style="border:none;">Logout</button>
          </form>
        {% elseif user_role == 'ROLE_DELIVERY_MAN' %}
          <a href="{{ path('app_driver_deliveries') }}" class="nav-btn">My Deliveries</a>
          <form method="post" action="{{ path('app_logout') }}" style="display:inline-flex; margin:0;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="nav-btn" style="border:none;">Logout</button>
          </form>
        {% elseif user_role == 'ROLE_CLIENT' %}
          <a href="{{ path('app_profile') }}" class="nav-btn">MY PROFILE</a>
          <a href="{{ path('app_client_orders') }}" class="nav-btn">MY ORDERS</a>
          <form method="post" action="{{ path('app_logout') }}" style="display:inline-flex; margin:0;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="nav-btn" style="border:none;">LOGOUT</button>
          </form>
        {% else %}
          <a href="{{ path('app_login') }}" class="nav-btn">Login</a>
        {% endif %}
      </div>
    </div>
  </nav>

  <!-- FLASH MESSAGES -->
  {% for message in app.flashes('error') %}
    <div class="flash-message flash-error" data-flash>
      {{ message }}
    </div>
  {% endfor %}
  {% for message in app.flashes('success') %}
    <div class="flash-message flash-success" data-flash>
      {{ message }}
    </div>
  {% endfor %}

  {% block body %}
  <!-- HERO -->
  <section class="hero" id="home">
    <div class="container hero-grid">
      <div class="reveal-left show">
        <div class="eyebrow">Tunis - Elevated Dining & Coffee</div>
        <h2>Where Coffee Meets <em>Luxury</em></h2>
        <div class="hero-sub">BIG 4 Coffee Lounge</div>
        <p class="lead">A refined escape for coffee lovers, dinner guests, and late-evening conversations - designed with warmth, elegance, and unforgettable atmosphere.</p>
        <div class="hero-actions">
          <a href="#" class="btn-primary" id="openBooking2">Reserve a Table</a>
          <a href="#gallery" class="btn-secondary">Discover the Space</a>
        </div>
      </div>

      <div class="hero-card reveal-right show">
        <small>Signature Experience</small>
        <h3>Modern Lounge Dining</h3>
        <p>From handcrafted espresso to intimate dinners and curated evenings, BIG 4 blends contemporary luxury with timeless hospitality.</p>
        <div class="hero-stats">
          <div><strong>4.9</strong><span>Guest Rating</span></div>
          <div><strong>48</strong><span>Signature Items</span></div>
          <div><strong>30m</strong><span>Fast Delivery</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <div class="container about-grid">
      <div class="about-image reveal-left">
        <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1200&q=80" alt="Luxury restaurant interior">
      </div>
      <div class="about-panel reveal-right">
        <small class="eyebrow" style="margin-bottom:1rem">Our Story</small>
        <h3 style="font-family:'Cormorant Garamond',serif;font-size:3.2rem;font-weight:300;line-height:1.05;color:var(--espresso)">A Space Crafted for <span style="color:var(--gold);font-style:italic">Taste & Atmosphere</span></h3>
        <p>BIG 4 was imagined as more than a cafe - a destination where refined design, gourmet flavors, and ambient evenings come together. Every detail is curated to feel elegant, intimate, and memorable.</p>
        <div class="stats-grid">
          <div class="stat"><strong>2023</strong><span>Founded in Tunis</span></div>
          <div class="stat"><strong>1.2K+</strong><span>Loyal Guests</span></div>
          <div class="stat"><strong>Midnight</strong><span>Open Until</span></div>
          <div class="stat"><strong>Private</strong><span>Reservations</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="features">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <small>Signature Offerings</small>
          <h3>Curated for a <em>Premium</em> Experience</h3>
        </div>
        <p>Every service is designed to feel polished, elevated, and indulgent - whether you're dining in, reserving for a special night, or ordering from home.</p>
      </div>

      <div class="cards">
        <div class="card reveal">
          <div class="number">01</div>
          <h4>Refined Menu</h4>
          <p>Specialty coffee, elegant desserts, gourmet plates, and signature beverages created to satisfy both daytime cravings and evening indulgence.</p>
        </div>
        <div class="card reveal">
          <div class="number">02</div>
          <h4>Private Reservations</h4>
          <p>Reserve your table for intimate dinners, stylish gatherings, business meetings, or a relaxed evening in a luxurious setting.</p>
        </div>
        <div class="card reveal">
          <div class="number">03</div>
          <h4>Luxury Delivery</h4>
          <p>Enjoy the BIG 4 experience at home with carefully packaged orders, prompt delivery, and presentation that feels premium.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOD MENU -->
  <section id="menu-section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <small>Luxury Menu</small>
          <h3>Signature <em>Flavours</em> of BIG 4</h3>
        </div>
        <p>A polished menu designed for coffee lovers, brunch guests, and elegant dining moments.</p>
      </div>

      {% if menuSections is defined and menuSections is not empty %}
        {# Count total available dishes across sections #}
        {% set totalDishes = 0 %}
        {% for section in menuSections %}
          {% set totalDishes = totalDishes + (section.dishes is defined ? section.dishes|length : 0) %}
        {% endfor %}

        {# If there are any dishes, render a consolidated Main Menu first so the page shows items clearly #}
        {% if totalDishes > 0 %}
          <div style="margin:1.2rem 0 .7rem;">
            <h4 style="font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:500;color:var(--espresso);margin:0;">Main Menu</h4>
            <p style="margin:.25rem 0 0;color:var(--text-2);">All available dishes</p>
          </div>

          <div class="menu-grid">
            {% set fallbackImage = 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=1000&q=80' %}
            {% for section in menuSections %}
              {% if section.dishes is defined and section.dishes|length > 0 %}
                {% for dish in section.dishes %}
                  <div class="menu-card reveal compact">
                    <div class="menu-card-inner">
                      <div class="menu-thumb">
                        <img src="{{ dish.imageUrl ?: fallbackImage }}" alt="{{ dish.name }}">
                      </div>
                      <div class="menu-card-content">
                        <h4>{{ dish.name }}</h4>
                        <p class="short-desc">{{ dish.description ?: 'Freshly prepared signature item from our kitchen.' }}</p>
                        <div class="menu-card-footer">
                          <span class="price">{{ dish.basePrice|number_format(2, '.', ' ') }} TND</span>
                          <button class="add-cart-btn" data-name="{{ dish.name }}" data-price="{{ dish.basePrice|number_format(2, '.', '') }}">Add to Cart</button>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>

          {# Instead of repeating dishes, show a compact category list linking to sections. #}
          <div style="margin:1.2rem 0 .7rem;">
            <h5 style="font-family:'Cormorant Garamond',serif;font-size:1.25rem;font-weight:500;color:var(--espresso);margin:0 0 .5rem;">Categories</h5>
            <div class="menu-categories" style="display:flex;flex-wrap:wrap;gap:.6rem">
              {% for section in menuSections %}
                {% if section.dishes is defined and section.dishes|length > 0 %}
                  <a href="#menu-section" class="menu-category" style="padding:.5rem .8rem;border:1px solid rgba(184,135,42,.12);border-radius:999px;background:rgba(255,255,255,.92);color:var(--brown);text-decoration:none;font-weight:600">{{ section.menu.title }} ({{ section.dishes|length }})</a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% else %}
          <div class="menu-grid">
            <div class="menu-card reveal">
              <div class="menu-card-content">
                <h4>Menu Coming Soon</h4>
                <p>Our dishes are being updated right now. Please check back shortly.</p>
                <span class="price">--</span>
              </div>
            </div>
          </div>
        {% endif %}
      {% else %}
        <div class="menu-grid">
          <div class="menu-card reveal">
            <div class="menu-card-content">
              <h4>Menu Coming Soon</h4>
              <p>Our dishes are being updated right now. Please check back shortly.</p>
              <span class="price">--</span>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </section>

  <!-- GALLERY -->
  <section id="gallery">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <small>Visual Atmosphere</small>
          <h3>Inside the <em>BIG 4</em> Experience</h3>
        </div>
        <p>Elegant interiors, signature drinks, and warm lighting - a destination designed to feel cinematic and unforgettable.</p>
      </div>
      <div class="gallery-grid">
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1200&q=80" alt="Luxury lounge interior"><span>Elegant Lounge Ambience</span></div>
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=900&q=80" alt="Coffee presentation"><span>Signature Coffee</span></div>
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=900&q=80" alt="Restaurant table setup"><span>Fine Dining Touch</span></div>
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1515669097368-22e68427d265?auto=format&fit=crop&w=900&q=80" alt="Dessert plating"><span>Curated Desserts</span></div>
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1521017432531-fbd92d768814?auto=format&fit=crop&w=900&q=80" alt="Elegant drinks"><span>Evening Signatures</span></div>
        <div class="gallery-item reveal"><img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=900&q=80" alt="Food"><span>Luxury Dining</span></div>
      </div>
    </div>
  </section>

  <!-- DELIVERY -->
  <section id="delivery">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <small>Fast Service</small>
          <h3>Elegant <em>Delivery</em> at Your Door</h3>
        </div>
        <p>Enjoy BIG 4 from the comfort of your home with premium packaging, stylish presentation, and carefully delivered orders.</p>
      </div>

      <div class="cards">
        <div class="card reveal"><div class="number">01</div><h4>Fast Arrival</h4><p>Freshly prepared items delivered promptly while preserving temperature, presentation, and taste.</p></div>
        <div class="card reveal"><div class="number">02</div><h4>Premium Packaging</h4><p>Luxury-inspired packaging designed to keep your order elegant and intact from our lounge to your table.</p></div>
        <div class="card reveal"><div class="number">03</div><h4>Easy Ordering</h4><p>A seamless experience for coffee, desserts, and signature dishes whenever you want BIG 4 at home.</p></div>
      </div>
    </div>
  </section>

  <!-- EVENTS -->
  <section id="events">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <small>Upcoming Moments</small>
          <h3>Events & <em>Exclusive Nights</em></h3>
        </div>
        <p>Open the donation calendar, pick an event, and leave your rating directly from the event detail page.</p>
      </div>
      <div class="event-list">
        <a class="event event-card-link reveal" href="{{ path('app_client_food_donation_calendar') }}">
          <div class="date">
            <strong>All</strong>
            <span>Calendar</span>
          </div>
          <div>
            <h5>Food Donation Calendar</h5>
            <p>Click anywhere on this card to open the calendar page.</p>
          </div>
        </a>

        {% if donationEvents is defined and donationEvents is not empty %}
          {% for event in donationEvents %}
            {% set eventDate = event.eventDate %}
            {% set eventStatus = event.status ?: 'Scheduled' %}
            {% set eventStatusKey = eventStatus|lower %}
            {% set eventStatusApiClass = eventStatusKey == 'in progress' ? 'in_progress' : eventStatusKey %}
            <div class="event reveal" data-event-id="{{ event.donationEventId }}">
              <div class="date">
                <strong>{{ eventDate ? eventDate|date('d') : '--' }}</strong>
                <span>{{ eventDate ? eventDate|date('M') : 'TBD' }}</span>
              </div>
              <div>
                <h5>{{ event.charityName ?: ('Event #' ~ event.donationEventId) }}</h5>
                <p>
                  {{ eventDate ? eventDate|date('F j, Y H:i') : 'Date to be announced' }}
                  · {{ event.totalQuantity }} items
                  · <span data-registration-count-for="{{ event.donationEventId }}">{{ registrationCounts[event.donationEventId]|default(0) }}</span> registered
                  · <span class="status status-{{ eventStatusApiClass }}" data-event-status>{{ eventStatus }}</span>
                  {% if event.deliveryId %}· Delivery #{{ event.deliveryId }}{% endif %}
                </p>
                {% if eventStatusKey == 'scheduled' %}
                  <div
                    class="event-inline-actions"
                    data-register-wrapper
                    data-registered="{{ event.donationEventId in (registeredEventIds|default([])) ? '1' : '0' }}"
                    data-register-token="{{ csrf_token('register-event' ~ event.donationEventId) }}"
                    data-unregister-token="{{ csrf_token('unregister-event' ~ event.donationEventId) }}"
                  >
                    {% if is_customer %}
                      {% if event.donationEventId in (registeredEventIds|default([])) %}
                        <div class="registered-badge">
                          <span>Registered</span>
                        </div>
                      {% else %}
                        <div class="register-status">
                          <span class="status-badge">SCHEDULED</span>
                          <span class="registered-count">0 registered</span>
                        </div>
                        <form method="post" action="{{ path('app_client_food_donation_register', {'id': event.donationEventId}) }}" class="js-event-register-form" data-event-id="{{ event.donationEventId }}">
                          <input type="hidden" name="_token" value="{{ csrf_token('register-event' ~ event.donationEventId) }}">
                          <button type="submit" class="event-register-btn-ui">Register</button>
                        </form>
                      {% endif %}
                    {% elseif not is_authenticated %}
                      <a href="{{ path('app_login') }}" class="event-register-btn-ui">Login to Register</a>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="event reveal">
            <div class="date"><strong>--</strong><span>--</span></div>
            <div>
              <h5>No donation events yet</h5>
              <p>New food donation events will appear here as soon as they are created.</p>
            </div>
          </div>
        {% endif %}
      </div>

      {% if is_customer %}
        <div class="my-registered-events-cta">
          <button type="button" class="btn-secondary" id="openMyRegisteredEvents">My Registered Events</button>
        </div>
      {% endif %}
    </div>
  </section>

  <!-- AI RECOMMENDATIONS SECTION -->
  {% if is_customer %}
    <section class="recommended-events-section" id="ai-recommendations">
      <div class="container">
        <div class="section-head reveal">
          <div>
            <small>Personalized With AI</small>
            <h3><span class="ai-badge">AI Picks For You</span> Recommended <em>Events</em></h3>
          </div>
          <p class="recommended-subtitle">Based on events you have registered for before.</p>
        </div>

        <div
          id="recommendations"
          data-recommended-events
          class="event-list events-container"
          data-authenticated="{{ is_authenticated ? '1' : '0' }}"
          data-user-role="{{ is_customer ? 'ROLE_CUSTOMER' : (app.request.session.get('user_role') ?: '') }}"
        >
          <div class="event reveal">
            <p>Loading recommendations...</p>
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  <!-- CTA -->
  <section class="cta">
    <div class="container">
      <div class="cta-box reveal">
        <h3>Your <span style="color:var(--gold);font-style:italic">Luxury Order</span></h3>
        <p>Add your favorite espresso, desserts, brunch selections, and signature dishes for a premium at-home experience.</p>
        <div class="hero-actions" style="justify-content:center;position:relative;z-index:1">
          <button class="btn-primary" id="openCart2">View Cart</button>
          <a href="#delivery" class="btn-secondary">Track Delivery</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer id="profile">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <h4>BIG 4 Coffee Lounge</h4>
          <p>An elegant destination in Tunis where refined coffee, sophisticated dining, and unforgettable evenings come together.</p>
        </div>
        <div class="footer-col">
          <h6>Navigate</h6>
          <a href="#home">Home</a><br>
          <a href="#about">About</a><br>
          <a href="#menu-section">Menu</a><br>
          <a href="#gallery">Gallery</a>
        </div>
        <div class="footer-col">
          <h6>Experience</h6>
          <a href="#">Reservations</a><br>
          <a href="#events">Events</a><br>
          <a href="#">Private Booking</a><br>
          <a href="#">Loyalty Program</a>
        </div>
        <div class="footer-col">
          <h6>Contact</h6>
          <address>
            Tunis, Tunisia<br>
            info@big4lounge.tn<br>
            +216 XX XXX XXX<br>
            Daily - 8 AM - Midnight
          </address>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; {{ "now"|date("Y") }} BIG 4 Coffee Lounge. All rights reserved.</span>
        <span>Privacy Policy - Terms</span>
      </div>
    </div>
  </footer>

  <!-- BOOKING POPUP -->
  <div class="popup-overlay" id="bookingPopup">
    <div class="popup-box">
      <button class="close-popup" id="closeBooking">&times;</button>
      <h3>Reserve Your Table</h3>
      <p>Book your luxury dining moment at BIG 4. Select your preferred date, time, and guest count.</p>

      <form class="booking-form" id="bookingForm">
        <div class="full">
          <input type="text" placeholder="Full Name" required>
        </div>
        <div>
          <input type="date" required>
        </div>
        <div>
          <input type="time" required>
        </div>
        <div class="full">
          <select required>
            <option value="">Select Guests</option>
            <option>1 Guest</option>
            <option>2 Guests</option>
            <option>3 Guests</option>
            <option>4 Guests</option>
            <option>5 Guests</option>
            <option>6+ Guests</option>
          </select>
        </div>
        <div class="full">
          <button type="submit" class="btn-primary" style="width:100%">Confirm Booking</button>
        </div>
      </form>
    </div>
  </div>

  <!-- PROFILE POPUP -->
  <div class="profile-overlay" id="profilePopup">
    <div class="profile-box">
      <button class="close-popup" id="closeProfile">&times;</button>
      <h3>Your Profile</h3>
      <p>Welcome to BIG 4 Lounge. Your profile can be used for future reservations, loyalty rewards, and personalized dining experiences.</p>

      <form class="booking-form" id="profileForm" method="post" action="{{ path('app_profile_quick_save') }}" data-authenticated="{{ isUserLoggedIn is defined and isUserLoggedIn ? '1' : '0' }}">
        <input type="hidden" name="_token" value="{{ csrf_token('profile_quick_save') }}">
        <div class="full">
          <input type="text" name="full_name" placeholder="Full Name" value="{{ user_name ?: '' }}">
        </div>
        <div>
          <input type="email" name="email" placeholder="Email Address" value="{{ user_email ?: '' }}">
        </div>
        <div>
          <input type="tel" name="phone" placeholder="Phone Number" value="{{ user_phone ?: '' }}">
        </div>
        <div class="full">
          <input type="text" name="address" placeholder="Address (optional)" value="{{ user_address ?: '' }}">
        </div>
        <div class="full">
          <button type="submit" class="btn-primary" style="width:100%">Save Profile</button>
        </div>
      </form>
    </div>
  </div>

  {% if is_customer %}
    <div class="popup-overlay" id="myRegisteredEventsPopup">
      <div class="popup-box my-events-popup-box">
        <div class="my-events-popup-head">
          <div>
            <h3 style="margin:0 0 .25rem;color:#fff;">My Registered Events</h3>
            <p style="margin:0;font-size:.82rem;color:var(--text-2);">Your current donation event registrations.</p>
          </div>
          <button class="close-popup" id="closeMyRegisteredEvents" style="position:static;flex-shrink:0;">&times;</button>
        </div>

        <div class="my-events-grid">
          {% if myRegisteredEvents is defined and myRegisteredEvents is not empty %}
            {% for event in myRegisteredEvents %}
              {% set eventDate = event.eventDate %}
              {% set eventStatus = event.status ?: 'Scheduled' %}
              <article class="my-event-card">
                <span class="my-event-date">{{ eventDate ? eventDate|date('M j, Y H:i') : 'Date TBD' }}</span>
                <h4 class="my-event-title">{{ event.charityName ?: ('Event #' ~ event.donationEventId) }}</h4>
                <p class="my-event-summary">
                  {{ event.totalQuantity }} items · {{ eventStatus }} ·
                  <span data-registration-count-for="{{ event.donationEventId }}">{{ registrationCounts[event.donationEventId]|default(0) }}</span> registered
                </p>
                <div class="event-inline-actions">
                  <a class="event-register-btn-ui" href="{{ path('app_client_food_donation_show', {'id': event.donationEventId}) }}">View Details</a>
                  <button
                    type="button"
                    class="event-register-btn-ui js-unregister-btn"
                    data-event-id="{{ event.donationEventId }}"
                    data-csrf="{{ csrf_token('unregister-event' ~ event.donationEventId) }}"
                  >Unregister</button>
                </div>
              </article>
            {% endfor %}
          {% else %}
            <p class="empty-copy js-no-events-msg">You are not registered for any events yet.</p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- CART DRAWER -->
  <div class="cart-overlay" id="cartOverlay">
    <div class="cart-drawer">
      <div class="cart-header">
        <h3>Your Cart</h3>
        <button class="close-popup" id="closeCart">&times;</button>
      </div>

      <div class="cart-items" id="cartItems">
        <div class="empty-cart">Your luxury cart is currently empty.</div>
      </div>

      <div class="cart-footer">
        <div class="cart-total">
          <span>Total</span>
          <strong id="cartTotal">0 TND</strong>
        </div>
        <button type="button" class="btn-primary" style="width:100%" id="checkoutBtn">Proceed to Checkout</button>
      </div>
    </div>
  </div>

  <!-- CHECKOUT REDIRECT FORM -->
  <form id="checkoutRedirectForm" method="get" action="{{ path('app_delivery_create') }}" style="display:none;">
    <input type="hidden" name="cart_items" id="redirectCartItemsInput">
    <input type="hidden" name="order_total" id="redirectCartTotalInput">
  </form>

  {% endblock %}

  {% block javascripts %}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/recommendations.js?v=2"></script>
  <script>
    (function () {
      const nav = document.getElementById('nav');
      if (nav) {
        window.addEventListener('scroll', () => {
          nav.classList.toggle('scrolled', window.scrollY > 40);
        });
      }

      const revealNodes = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');
      if (!revealNodes.length) {
        return;
      }

      if (!('IntersectionObserver' in window)) {
        revealNodes.forEach((node) => node.classList.add('show'));
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }

          entry.target.classList.add('show');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12 });

      revealNodes.forEach((node) => observer.observe(node));
    })();
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const flashMessages = document.querySelectorAll('[data-flash]');
      flashMessages.forEach((msg) => {
        window.setTimeout(() => {
          msg.style.transition = 'opacity 0.3s ease';
          msg.style.opacity = '0';
          window.setTimeout(() => msg.remove(), 300);
        }, 3000);
      });
    });
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const openBtn = document.getElementById('openMyRegisteredEvents');
      const popup = document.getElementById('myRegisteredEventsPopup');
      const closeBtn = document.getElementById('closeMyRegisteredEvents');

      if (!openBtn || !popup || !closeBtn) {
        return;
      }

      function openPopup() {
        popup.classList.add('active');
        document.body.style.overflow = 'hidden';
        document.dispatchEvent(new CustomEvent('my-registrations:open'));
      }

      function closePopup() {
        popup.classList.remove('active');
        document.body.style.overflow = '';
      }

      openBtn.addEventListener('click', openPopup);
      closeBtn.addEventListener('click', closePopup);

      popup.addEventListener('click', function (event) {
        if (event.target === popup) {
          closePopup();
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          closePopup();
        }
      });
    });
  </script>
  <script>
    (function () {
      const REGISTRATION_STATE_ENDPOINT = '{{ path('app_client_food_donation_registration_state') }}';
      const REGISTRATION_SYNC_MS = 15000;

      const showToast = (message, type = 'success') => {
        const toast = document.createElement('div');
        toast.className = `flash-message ${type === 'error' ? 'flash-error' : 'flash-success'}`;
        toast.textContent = String(message || 'Done.');
        document.body.prepend(toast);
        window.setTimeout(() => {
          toast.remove();
        }, 2600);
      };

      window.BIG4ShowToast = showToast;

      const escapeHtml = (value) => String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

      const setRegistrationCount = (eventId, count) => {
        document.querySelectorAll(`[data-registration-count-for="${eventId}"]`).forEach((node) => {
          node.textContent = String(Number(count || 0));
        });
      };

      const setButtonState = (button, action) => {
        const normalized = action === 'register' ? 'register' : 'unregister';
        button.dataset.action = normalized;
        button.textContent = normalized === 'register' ? 'Register' : 'Unregister';
        button.classList.toggle('btn-register', normalized === 'register');
        button.classList.toggle('btn-unregister', normalized === 'unregister');
        button.classList.toggle('btn-unregister-sm', normalized === 'unregister' && button.classList.contains('btn-unregister-sm'));
      };

      const replaceEventCardRegisterState = (eventId, isRegistered, registerToken) => {
        const wrapper = document.querySelector(`.event[data-event-id="${eventId}"] [data-register-wrapper]`);
        if (!wrapper) {
          return;
        }

        const currentToken = wrapper.querySelector('input[name="_token"]')?.value || '';
        const effectiveToken = String(registerToken || currentToken || '');
        const unregisterToken = String(wrapper.dataset.unregisterToken || '');
        const registerUrl = `/client/food-donation/event/${eventId}/register`;
        const unregisterUrl = `/client/food-donation/event/${eventId}/unregister`;

        if (isRegistered) {
          wrapper.dataset.registered = '1';
          wrapper.innerHTML = `
            <div class="registered-badge">
              <span>Registered</span>
            </div>
          `;
          return;
        }

        wrapper.dataset.registered = '0';
        wrapper.innerHTML = `
          <form method="post" action="/client/food-donation/event/${eventId}/register" class="js-event-register-form" data-event-id="${eventId}">
            <input type="hidden" name="_token" value="${effectiveToken}">
            <button type="submit" class="event-register-btn-ui">Register</button>
          </form>
        `;
      };

      const renderMyRegisteredEvents = (events) => {
        const grid = document.querySelector('#myRegisteredEventsPopup .my-events-grid');
        if (!grid) {
          return;
        }

        if (!Array.isArray(events) || events.length === 0) {
          grid.innerHTML = '<p class="empty-copy js-no-events-msg">You have no registered events.</p>';
          return;
        }

        grid.innerHTML = events.map((event) => {
          const eventId = Number(event.id || 0);
          return `
            <article class="my-event-card">
              <span class="my-event-date">${escapeHtml(event.event_date || 'Date TBD')}</span>
              <h4 class="my-event-title">${escapeHtml(event.charity_name || ('Event #' + eventId))}</h4>
              <p class="my-event-summary">
                ${Number(event.total_quantity || 0)} items · ${escapeHtml(event.status || 'Scheduled')} ·
                <span data-registration-count-for="${eventId}">${Number(event.registration_count || 0)}</span> registered
              </p>
              <div class="event-inline-actions">
                <a class="event-register-btn-ui" href="${escapeHtml(event.view_url || '#')}">View Details</a>
                <button
                  type="button"
                  class="event-register-btn-ui js-unregister-btn"
                  data-event-id="${eventId}"
                  data-unregister-url="${escapeHtml(event.unregister_url || '')}"
                  data-csrf="${escapeHtml(event.unregister_token || '')}"
                >Unregister</button>
              </div>
            </article>
          `;
        }).join('');
      };

      const upsertMyRegisteredEventCard = (eventId, registrationCount = 0, eventData = null) => {
        const grid = document.querySelector('#myRegisteredEventsPopup .my-events-grid');
        if (!grid || !eventId) {
          return;
        }

        const existingCard = grid.querySelector(`.my-event-card [data-event-id="${eventId}"]`)?.closest('.my-event-card');
        if (existingCard) {
          const countNode = existingCard.querySelector(`[data-registration-count-for="${eventId}"]`);
          if (countNode) {
            countNode.textContent = String(Number(registrationCount || 0));
          }
          return;
        }

        const emptyMessage = grid.querySelector('.js-no-events-msg');
        if (emptyMessage) {
          emptyMessage.remove();
        }

        const eventRow = document.querySelector(`.event[data-event-id="${eventId}"]`);
        const title = String(eventData?.charity_name || eventRow?.querySelector('h5')?.textContent || `Event #${eventId}`).trim();
        const status = String(eventData?.status || eventRow?.querySelector('[data-event-status]')?.textContent || 'Scheduled').trim();

        const summaryText = (eventRow?.querySelector('p')?.textContent || 'Date TBD').replace(/\s+/g, ' ').trim();
        const summaryParts = summaryText.split('·').map((part) => part.trim()).filter(Boolean);
        const eventDate = String(eventData?.event_date || (summaryParts.length > 0 ? summaryParts[0] : 'Date TBD')).trim();

        let quantity = Number(eventData?.total_quantity || 0);
        const qtyMatch = summaryText.match(/(\d+)\s*items/i);
        if (quantity <= 0 && qtyMatch && qtyMatch[1]) {
          quantity = Number(qtyMatch[1]) || 0;
        }

        const registerWrapper = eventRow?.querySelector('[data-register-wrapper]');
        const unregisterToken = String(eventData?.unregister_token || registerWrapper?.dataset.unregisterToken || '');
        const viewUrl = String(eventData?.view_url || `/client/food-donation/event/${eventId}`);
        const unregisterUrl = String(eventData?.unregister_url || `/client/food-donation/event/${eventId}/unregister`);

        const card = document.createElement('article');
        card.className = 'my-event-card';
        card.innerHTML = `
          <span class="my-event-date">${escapeHtml(eventDate)}</span>
          <h4 class="my-event-title">${escapeHtml(title)}</h4>
          <p class="my-event-summary">
            ${Number(quantity)} items · ${escapeHtml(status)} ·
            <span data-registration-count-for="${eventId}">${Number(registrationCount || 0)}</span> registered
          </p>
          <div class="event-inline-actions">
            <a class="event-register-btn-ui" href="${escapeHtml(viewUrl)}">View Details</a>
            <button
              type="button"
              class="event-register-btn-ui js-unregister-btn"
              data-event-id="${eventId}"
              data-unregister-url="${escapeHtml(unregisterUrl)}"
              data-csrf="${escapeHtml(unregisterToken)}"
            >Unregister</button>
          </div>
        `;

        card.style.opacity = '0';
        card.style.transform = 'translateY(8px)';
        grid.prepend(card);
        requestAnimationFrame(() => {
          card.style.transition = 'opacity 0.22s ease, transform 0.22s ease';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        });
      };

      const updateMyRegistrationsPage = (eventId, isRegistered) => {
        const card = document.querySelector(`.my-reg-card [data-event-id="${eventId}"]`)?.closest('.my-reg-card');
        const grid = document.querySelector('.my-reg-grid');
        const shell = document.querySelector('.my-registrations-shell');

        if (!card) {
          return;
        }

        if (!isRegistered) {
          card.remove();
        }

        if (grid && grid.children.length === 0 && shell && !shell.querySelector('.my-reg-empty')) {
          const empty = document.createElement('div');
          empty.className = 'my-reg-empty';
          empty.innerHTML = `
            <p>You have not registered for any events yet.</p>
            <a href="{{ path('app_client_food_donation_calendar') }}" class="btn-register-link">Browse Events</a>
          `;
          grid.remove();
          shell.appendChild(empty);
        }
      };

      const notifyRecommendationsRefresh = (options = {}) => {
        document.dispatchEvent(new CustomEvent('recommendations:refresh', {
          detail: options,
        }));
      };

      const syncRegistrationState = async (options = {}) => {
        const shouldRefreshRecommendations = options.notifyRecommendations === true;
        const popup = document.getElementById('myRegisteredEventsPopup');
        if (!popup) {
          return;
        }

        try {
          const response = await fetch(REGISTRATION_STATE_ENDPOINT, {
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'Accept': 'application/json',
            },
          });

          if (!response.ok) {
            return;
          }

          const payload = await response.json();
          if (!payload || payload.success !== true) {
            return;
          }

          const registrationCounts = payload.registration_counts || {};
          Object.keys(registrationCounts).forEach((eventId) => {
            setRegistrationCount(Number(eventId), registrationCounts[eventId]);
          });

          const registeredEventIds = new Set((payload.registered_event_ids || []).map((id) => Number(id)));
          const eventMap = new Map((payload.my_events || []).map((event) => [Number(event.id || 0), event]));

          document.querySelectorAll('.event[data-event-id]').forEach((eventNode) => {
            const eventId = Number(eventNode.getAttribute('data-event-id') || 0);
            if (!eventId) {
              return;
            }

            const isRegistered = registeredEventIds.has(eventId);
            const eventData = eventMap.get(eventId);
            replaceEventCardRegisterState(eventId, isRegistered, String(eventData?.register_token || ''));
          });

          renderMyRegisteredEvents(payload.my_events || []);
          if (shouldRefreshRecommendations) {
            notifyRecommendationsRefresh({
              instant: true,
              forceLoading: true,
            });
          }
        } catch (error) {
          console.error('Registration sync failed:', error);
        }
      };

      const postEventAction = async ({ url, token }) => {
        const formData = new FormData();
        formData.append('_token', token);

        const response = await fetch(url, {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json',
          },
        });

        const payload = await response.json();
        if (!response.ok || !payload.success) {
          throw new Error(payload.message || 'Request failed.');
        }

        return payload;
      };

      const setInlineRegisterButtonLoading = (button, isLoading, loadingText = 'Registering...') => {
        if (!button) {
          return;
        }

        if (!button.dataset.defaultText) {
          button.dataset.defaultText = String(button.textContent || 'Register');
        }

        if (isLoading) {
          button.disabled = true;
          button.classList.add('is-registering');
          button.textContent = loadingText;
          return;
        }

        button.disabled = false;
        button.classList.remove('is-registering');
        button.textContent = button.dataset.defaultText;
      };

      document.addEventListener('submit', async (event) => {
        const form = event.target.closest('.js-event-register-form');
        if (!form) {
          return;
        }

        event.preventDefault();

        const submitButton = form.querySelector('button[type="submit"]');
        if (!submitButton) {
          return;
        }

        const eventId = Number(form.dataset.eventId || 0);
        const registerToken = String(form.querySelector('input[name="_token"]')?.value || '');
        setInlineRegisterButtonLoading(submitButton, true, 'Registering...');

        try {
          const payload = await postEventAction({
            url: form.action,
            token: registerToken,
          });

          setRegistrationCount(eventId, payload.registration_count ?? 0);
          replaceEventCardRegisterState(eventId, true, registerToken);
          upsertMyRegisteredEventCard(eventId, payload.registration_count ?? 0, payload.registered_event || null);
          showToast(payload.message || 'You are now registered for this event.', 'success');
          notifyRecommendationsRefresh({
            instant: true,
            forceLoading: true,
          });
          await syncRegistrationState({ notifyRecommendations: false });
        } catch (error) {
          setInlineRegisterButtonLoading(submitButton, false);
          showToast(error instanceof Error ? error.message : 'Registration failed. Please try again.', 'error');
        }
      });

      document.addEventListener('click', async (event) => {
        const modalUnregisterButton = event.target.closest('.js-unregister-btn');
        if (modalUnregisterButton && modalUnregisterButton.closest('#myRegisteredEventsPopup')) {
          event.preventDefault();
          event.stopPropagation();

          const eventId = modalUnregisterButton.dataset.eventId;
          const csrfToken = modalUnregisterButton.dataset.csrf || modalUnregisterButton.dataset.unregisterToken || '';
          const eventTitle = modalUnregisterButton.closest('.my-event-card')?.querySelector('.my-event-title')?.textContent || 'this event';

          if (!eventId || !csrfToken) {
            showToast('Unable to unregister right now. Please refresh and try again.', 'error');
            return;
          }

          const confirmModal = document.createElement('div');
          confirmModal.className = 'custom-confirm-modal';
          confirmModal.innerHTML = `
            <div class="custom-confirm-box">
              <h4>Unregister from "${escapeHtml(eventTitle)}"?</h4>
              <p>You will be removed from this event.</p>
              <div class="confirm-actions">
                <button class="confirm-cancel-btn" type="button">Cancel</button>
                <button class="confirm-proceed-btn" type="button">Unregister</button>
              </div>
            </div>
          `;

          document.body.appendChild(confirmModal);

          const closeConfirmModal = () => {
            if (confirmModal.parentNode) {
              confirmModal.remove();
            }
          };

          confirmModal.querySelector('.confirm-cancel-btn')?.addEventListener('click', closeConfirmModal);

          confirmModal.querySelector('.confirm-proceed-btn')?.addEventListener('click', async () => {
            modalUnregisterButton.disabled = true;
            modalUnregisterButton.textContent = 'Unregistering...';

            try {
              const response = await fetch(
                `{{ path('app_client_food_donation_unregister', {'id': 'PLACEHOLDER'}) }}`.replace('PLACEHOLDER', eventId),
                {
                  method: 'POST',
                  headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'Accept': 'application/json',
                  },
                  body: '_token=' + encodeURIComponent(csrfToken),
                }
              );

              const payload = await response.json();
              if (!response.ok || !payload.success) {
                throw new Error(payload.message || 'Failed to unregister. Please try again.');
              }

              const numericEventId = Number(eventId);
              setRegistrationCount(numericEventId, payload.registration_count ?? 0);

              const card = modalUnregisterButton.closest('.my-event-card');
              if (card) {
                card.style.transition = 'opacity 0.3s ease';
                card.style.opacity = '0';

                window.setTimeout(() => {
                  card.remove();
                  const popupGrid = document.querySelector('#myRegisteredEventsPopup .my-events-grid');
                  if (popupGrid && popupGrid.querySelectorAll('.my-event-card').length === 0) {
                    popupGrid.innerHTML = '<p class="empty-copy js-no-events-msg">You are not registered for any events yet.</p>';
                  }
                }, 300);
              }

              replaceEventCardRegisterState(numericEventId, false, String(modalUnregisterButton.dataset.registerToken || ''));
              updateMyRegistrationsPage(numericEventId, false);
              showToast(payload.message || 'You have been unregistered from this event.', 'success');
              document.dispatchEvent(new CustomEvent('recommendations:refresh', {
                detail: {
                  instant: true,
                  forceLoading: true,
                },
              }));
              await syncRegistrationState({ notifyRecommendations: false });
            } catch (error) {
              modalUnregisterButton.disabled = false;
              modalUnregisterButton.textContent = 'Unregister';
              showToast(error instanceof Error ? error.message : 'An error occurred. Please try again.', 'error');
            } finally {
              closeConfirmModal();
            }
          });

          confirmModal.addEventListener('click', (clickEvent) => {
            if (clickEvent.target === confirmModal) {
              closeConfirmModal();
            }
          });

          return;
        }

        const toggleButton = event.target.closest('.js-event-toggle-btn');
        if (!toggleButton) {
          return;
        }

        const eventId = Number(toggleButton.dataset.eventId || 0);
        const action = String(toggleButton.dataset.action || 'unregister').toLowerCase();
        const isRegisterAction = action === 'register';
        const actionUrl = isRegisterAction ? toggleButton.dataset.registerUrl : toggleButton.dataset.unregisterUrl;
        const token = isRegisterAction ? toggleButton.dataset.registerToken : toggleButton.dataset.unregisterToken;
        const previousText = toggleButton.textContent;

        if (!actionUrl || !token) {
          return;
        }

        toggleButton.disabled = true;
        toggleButton.textContent = 'Loading...';

        try {
          const payload = await postEventAction({ url: actionUrl, token });
          const isNowRegistered = Boolean(payload.registered);

          setRegistrationCount(eventId, payload.registration_count ?? 0);
          setButtonState(toggleButton, isNowRegistered ? 'unregister' : 'register');
          replaceEventCardRegisterState(eventId, isNowRegistered, String(toggleButton.dataset.registerToken || ''));
          updateMyRegistrationsPage(eventId, isNowRegistered);
          showToast(payload.message || 'Registration updated.', 'success');
          await syncRegistrationState({ notifyRecommendations: true });
        } catch (error) {
          toggleButton.textContent = previousText;
          showToast(error instanceof Error ? error.message : 'Action failed. Please try again.', 'error');
        } finally {
          toggleButton.disabled = false;
        }
      });

      syncRegistrationState();
      window.setInterval(syncRegistrationState, REGISTRATION_SYNC_MS);

      document.addEventListener('my-registrations:open', () => {
        syncRegistrationState();
      });

      document.addEventListener('registration-state-changed', (event) => {
        const detail = event.detail || {};
        const eventId = Number(detail.eventId || 0);

        if (eventId > 0) {
          const registrationCount = Number(detail.registrationCount || 0);
          const eventData = detail.event && typeof detail.event === 'object' ? detail.event : null;
          const registerToken = String(eventData?.register_token || '');

          setRegistrationCount(eventId, registrationCount);
          replaceEventCardRegisterState(eventId, true, registerToken);
          upsertMyRegisteredEventCard(eventId, registrationCount, eventData);
        }

        syncRegistrationState({ notifyRecommendations: false });
      });
    })();
  </script>
  <script>
    (function () {
      const STATUS_ENDPOINT = '/api/refresh-event-statuses';
      const INTERVAL_MS = 30000;

      const prettyLabel = (apiStatus) => {
        const mapping = {
          SCHEDULED: 'Scheduled',
          IN_PROGRESS: 'In Progress',
          ONGOING: 'Ongoing',
          COMPLETED: 'Completed',
          CANCELLED: 'Cancelled',
        };

        return mapping[apiStatus] || 'Scheduled';
      };

      const refreshStatuses = async () => {
        try {
          const response = await fetch(STATUS_ENDPOINT, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
          });

          if (!response.ok) {
            throw new Error('Refresh failed');
          }

          const data = await response.json();
          if (!data || data.success !== true || !Array.isArray(data.events)) {
            return;
          }

          data.events.forEach((eventItem) => {
            const row = document.querySelector(`[data-event-id="${eventItem.id}"]`);
            if (!row) {
              return;
            }

            const apiStatus = String(eventItem.status || 'SCHEDULED').toUpperCase();
            const statusNode = row.querySelector('[data-event-status]');
            if (statusNode) {
              statusNode.textContent = prettyLabel(apiStatus);
              statusNode.className = `status status-${apiStatus.toLowerCase()}`;
            }

            const registerWrapper = row.querySelector('[data-register-wrapper]');
            if (registerWrapper) {
              registerWrapper.style.display = apiStatus === 'SCHEDULED' ? '' : 'none';
            }
          });
        } catch (error) {
          console.error('Home event refresh failed:', error);
        }
      };

      refreshStatuses();
      setInterval(refreshStatuses, INTERVAL_MS);
    })();
  </script>
  {% endblock %}
</body>
</html>
