    function getComfortScore(forecast) {
      const humidity = typeof forecast.humidity === 'number' ? forecast.humidity : null;
      const windSpeed = typeof forecast.wind_speed === 'number' ? forecast.wind_speed : null;
      const gust = typeof forecast.wind_gust === 'number' ? forecast.wind_gust : null;
      const feelsLike = typeof forecast.feels_like === 'number' ? forecast.feels_like : null;
      const rainChance = typeof forecast.precipitation_probability === 'number' ? forecast.precipitation_probability : null;

      let score = 100;

      if (humidity !== null) {
        score -= Math.max(0, humidity - 60) * 0.6;
      }

      if (windSpeed !== null) {
        score -= Math.max(0, windSpeed - 10) * 2.2;
      }

      if (gust !== null) {
        score -= Math.max(0, gust - 18) * 1.2;
      }

      if (feelsLike !== null) {
        const comfortGap = Math.abs(feelsLike - 24);
        score -= Math.max(0, comfortGap - 3) * 2.4;
      }

      if (rainChance !== null) {
        score -= Math.max(0, rainChance - 20) * 0.45;
      }

      return Math.max(0, Math.min(100, Math.round(score)));
    }

