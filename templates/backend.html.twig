<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}BIG4 Admin{% endblock %}</title>
    <style>
        body { margin: 0; font-family: Arial, sans-serif; background: #f5f7fb; color: #1f2937; }
        .layout { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
        .sidebar { background: #111827; color: #e5e7eb; padding: 18px; }
        .sidebar h2 { margin: 0 0 12px; font-size: 18px; }
        .sidebar a { color: #cbd5e1; text-decoration: none; display: block; padding: 6px 0; }
        .main { padding: 20px; }
        .topbar { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px 16px; margin-bottom: 14px; }
        .content-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 16px; }
    </style>
    {% block page_styles %}{% endblock %}
    {% block stylesheets %}{% endblock %}
</head>
<body>
<div class="layout">
    <aside class="sidebar">
        <h2>BIG4 Admin</h2>
        <a href="{{ path('app_admin_dashboard') }}">Dashboard</a>
        <a href="{{ path('app_food_donation_event_index') }}">Donation Events</a>
        <a href="{{ path('app_reservation_index') }}">Reservations</a>
    </aside>
    <main class="main">
        <div class="topbar">
            <strong>{% block topbar_title %}Admin Area{% endblock %}</strong>
            <div>{% block topbar_breadcrumb %}{% endblock %}</div>
        </div>
        <div class="content-card">
            {% block body %}
                {% block content %}{% endblock %}
            {% endblock %}
        </div>
    </main>
</div>
{% block javascripts %}{% endblock %}
</body>
</html>
