{% extends 'frontend.html.twig' %}

{% block title %}Food Donation Events{% endblock %}

{% block body %}
    <section class="donations-hero">
        <div class="container">
            <div class="hero-copy">
                <p class="eyebrow">Community impact</p>
                <h1>Food Donation Events</h1>
                <p>Browse upcoming and recent donation events, see what is being prepared, and share feedback after each event.</p>
            </div>
        </div>
    </section>

    <section class="donations-grid-section">
        <div class="container">
            <div class="donations-grid">
                {% for event in food_donation_events %}
                    <article class="donation-card">
                        <div class="card-top">
                            <div>
                                <p class="card-date">{{ event.eventDate ? event.eventDate|date('F j, Y') : 'Date TBA' }}</p>
                                <h3>{{ event.charityName }}</h3>
                            </div>
                            <span class="status-pill status-{{ (event.status ?: 'unknown')|lower|replace({'_':'-'}) }}">{{ event.status ?: 'UNKNOWN' }}</span>
                        </div>
                        <div class="card-meta">
                            <div>
                                <span class="meta-label">Planned portions</span>
                                <strong>{{ event.totalQuantity }}</strong>
                            </div>
                            <div>
                                <span class="meta-label">Event ID</span>
                                <strong>#{{ event.donationEventId }}</strong>
                            </div>
                        </div>
                        <a class="card-link" href="{{ path('app_food_donation_event_public_show', {'donation_event_id': event.donationEventId}) }}">View details</a>
                    </article>
                {% else %}
                    <div class="empty-state">No donation events published yet.</div>
                {% endfor %}
            </div>
        </div>
    </section>

    <style>
        .donations-hero {
            padding: 140px 0 60px;
        }
        .hero-copy {
            max-width: 640px;
        }
        .hero-copy h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.4rem, 3.8vw, 3.6rem);
            margin: .6rem 0 1rem;
            color: var(--espresso);
        }
        .hero-copy p {
            color: var(--text-2);
            font-size: 1.05rem;
            line-height: 1.7;
        }
        .eyebrow {
            text-transform: uppercase;
            letter-spacing: .25em;
            font-size: .62rem;
            color: var(--gold);
            font-weight: 600;
        }
        .donations-grid-section {
            padding: 20px 0 90px;
        }
        .donations-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1.4rem;
        }
        .donation-card {
            background: linear-gradient(145deg, rgba(255,255,255,.96), rgba(242,230,211,.92));
            border: 1px solid var(--line-2);
            border-radius: 18px;
            padding: 1.4rem 1.5rem;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .card-top {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            align-items: flex-start;
        }
        .card-date {
            font-size: .75rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--text-3);
            margin-bottom: .4rem;
        }
        .donation-card h3 {
            font-size: 1.3rem;
            font-family: 'Cormorant Garamond', serif;
            color: var(--espresso);
        }
        .card-meta {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
            padding: .9rem 0;
            border-top: 1px solid rgba(184,135,42,.2);
            border-bottom: 1px solid rgba(184,135,42,.2);
        }
        .meta-label {
            display: block;
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .16em;
            color: var(--text-3);
            margin-bottom: .2rem;
        }
        .card-link {
            align-self: flex-start;
            font-size: .7rem;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: var(--gold);
            font-weight: 700;
        }
        .status-pill {
            padding: .35rem .85rem;
            border-radius: 999px;
            font-size: .6rem;
            letter-spacing: .16em;
            text-transform: uppercase;
            border: 1px solid transparent;
            font-weight: 700;
            background: rgba(184,135,42,.1);
            color: var(--gold);
        }
        .status-pill.status-pending { background: rgba(58,126,201,.14); color: #2363ac; border-color: rgba(58,126,201,.2); }
        .status-pill.status-scheduled { background: rgba(124,79,196,.14); color: #7043b8; border-color: rgba(124,79,196,.2); }
        .status-pill.status-in-progress { background: rgba(255,168,38,.14); color: #b56a12; border-color: rgba(255,168,38,.2); }
        .status-pill.status-completed { background: rgba(46,158,106,.14); color: #228657; border-color: rgba(46,158,106,.2); }
        .status-pill.status-cancelled { background: rgba(217,64,64,.12); color: #b83131; border-color: rgba(217,64,64,.2); }
        .empty-state {
            padding: 2rem;
            text-align: center;
            border: 1px dashed var(--line-2);
            border-radius: 14px;
            background: rgba(255,255,255,.6);
            color: var(--text-2);
            grid-column: 1 / -1;
        }
    </style>
{% endblock %}
